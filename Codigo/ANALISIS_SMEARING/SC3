                 label=f'Fit sigma1: a={a1:.3f}+-{ea1:.3f}')
        f_out.write(f"sigma1: a={a1:.4f}+-{ea1:.4f}, b={b1:.4f}+-{eb1:.4f}\n")

    if res2:
        a2, b2, ea2, eb2 = res2
        xf = np.linspace(min(x2), max(x2), 200)
        plt.plot(xf, a2*xf+b2, color='red', linewidth=2,
                 label=f'Fit sigma2: a={a2:.3f}+-{ea2:.3f}')
        f_out.write(f"sigma2: a={a2:.4f}+-{ea2:.4f}, b={b2:.4f}+-{eb2:.4f}\n")

    plt.xlabel("Smearing [mm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

# =========================
# PLOT COMBINADO: 3 hits + sigma1, sigma2 de 4 hits
# =========================

def plot_combinado(s_hit,
                   sg3,   err3,
                   sg1_4, err1_4,
                   sg2_4, err2_4,
                   titulo, nombre):

    x3, y3, e3 = limpiar_datos(s_hit, sg3,   err3)
    x1, y1, e1 = limpiar_datos(s_hit, sg1_4, err1_4)
    x2, y2, e2 = limpiar_datos(s_hit, sg2_4, err2_4)

    plt.figure(figsize=(9,6))
    plt.errorbar(x3, y3, yerr=e3, fmt='o', color='green', capsize=3,
                 label='3 hits (gaussiana simple)')
    plt.errorbar(x1, y1, yerr=e1, fmt='o', color='blue',  capsize=3,
                 label='4 hits sigma1 (core)')
    plt.errorbar(x2, y2, yerr=e2, fmt='s', color='red',   capsize=3,
                 label='4 hits sigma2 (cola)')

    f_out.write(f"\n--- {titulo} (combinado) ---\n")

    for (x, y, e, color, etiqueta) in [
        (x3, y3, e3, 'green', '3hits sigma'),
        (x1, y1, e1, 'blue',  '4hits sigma1'),
        (x2, y2, e2, 'red',   '4hits sigma2')
    ]:
        res = fit_lineal(x, y, e)
        if res:
            a, b, ea, eb = res
            xf = np.linspace(min(x), max(x), 200)
            plt.plot(xf, a*xf+b, color=color, linewidth=2,
                     label=f'Fit {etiqueta}: a={a:.3f}+-{ea:.3f}')
            f_out.write(f"{etiqueta}: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")

    plt.xlabel("Smearing [mm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

# =========================
# CAMBIO: sigma_eff de 4 hits vs sigma de 3 hits
# =========================

def plot_sigma_eff_vs_3hits(s_hit,
                             sg3,    err3,
                             sg_eff, 
                             titulo, nombre):
    """
    Compara sigma de 3 hits (gaussiana simple) con sigma_eff de 4 hits.
    sigma_eff no tiene error propagado en el archivo, se plotea sin barras.
    """

    x3,   y3,   e3   = limpiar_datos(s_hit, sg3,    err3)
    xeff, yeff        = limpiar_datos(s_hit, sg_eff)

    plt.figure(figsize=(9,6))
    plt.errorbar(x3,   y3,   yerr=e3, fmt='o', color='blue',  capsize=3,
                 label='3 hits sigma (gaussiana simple)')
    plt.plot(xeff, yeff, 's', color='red', markersize=5,
             label='4 hits sigma_eff')

    f_out.write(f"\n--- {titulo} ---\n")

    for (x, y, e, color, etiqueta) in [
        (x3,   y3,   e3,            'blue', '3hits sigma'),
        (xeff, yeff, np.ones_like(yeff)*yeff.mean()*0.01, 'red',  '4hits sigma_eff')
    ]:
        res = fit_lineal(x, y, e)
        if res:
            a, b, ea, eb = res
            xf = np.linspace(min(x), max(x), 200)
            plt.plot(xf, a*xf+b, color=color, linewidth=2,
                     label=f'Fit {etiqueta}: a={a:.3f}+-{ea:.3f}')
            f_out.write(f"{etiqueta}: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")

    plt.xlabel("Smearing [mm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

# =========================
# CAMBIO: sigma conjunta 3+4 hits (sigma de 3 y sigma_eff de 4 juntas)
# =========================

def plot_sigma_conjunta(s_hit,
                        sg3,    err3,
                        sg_eff,
                        titulo, nombre):
    """
    Une sigma de 3 hits y sigma_eff de 4 hits en un único conjunto
    de puntos y hace un solo fit lineal sobre todos.
    """

    x3,   y3,   e3   = limpiar_datos(s_hit, sg3,    err3)
    xeff, yeff        = limpiar_datos(s_hit, sg_eff)

    # combinar — sigma_eff sin error: usar error pequeño relativo (1%)
    eeff = yeff * 0.01

    x_all = np.concatenate([x3,   xeff])
    y_all = np.concatenate([y3,   yeff])
    e_all = np.concatenate([e3,   eeff])

    # ordenar por smearing
    orden = np.argsort(x_all)
    x_all = x_all[orden]
    y_all = y_all[orden]
    e_all = e_all[orden]

    plt.figure(figsize=(9,6))
    plt.errorbar(x3,   y3,   yerr=e3,   fmt='o', color='blue', capsize=3,
                 label='3 hits sigma')
    plt.plot(xeff, yeff, 's', color='red', markersize=5,
             label='4 hits sigma_eff')

    res = fit_lineal(x_all, y_all, e_all)
    if res:
        a, b, ea, eb = res
        xf = np.linspace(min(x_all), max(x_all), 200)
        plt.plot(xf, a*xf+b, color='black', linewidth=2,
                 label=f'Fit conjunto: a={a:.3f}+-{ea:.3f}, b={b:.4f}+-{eb:.4f}')
        f_out.write(f"\n--- {titulo} ---\n")
        f_out.write(f"fit conjunto: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")

    plt.xlabel("Smearing [mm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

