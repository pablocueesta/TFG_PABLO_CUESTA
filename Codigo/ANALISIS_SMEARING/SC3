# =========================
# PLOT 3 HITS: gaussiana simple
# =========================

def plot_3hits(s_hit, sg, err, titulo, nombre):

    x, y, e = limpiar_datos(s_hit, sg, err)
    if len(x) < 3:
        print(f"Pocos puntos validos para {titulo}")
        return

    plt.figure(figsize=(8,6))
    plt.errorbar(x, y, yerr=e, fmt='o', color='blue', capsize=3,
                 label='sigma (gaussiana simple)')

    res = fit_lineal(x, y, e)
    if res:
        a, b, ea, eb = res
        xfit = np.linspace(min(x), max(x), 200)
        plt.plot(xfit, a*xfit+b, color='blue', linewidth=2,
                 label=f'Fit: a={a:.3f}+-{ea:.3f}, b={b:.4f}+-{eb:.4f}')
        f_out.write(f"\n--- {titulo} ---\n")
        f_out.write(f"sigma: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")
        print(f"{titulo}: a={a:.4f}+-{ea:.4f}")

    plt.xlabel("Smearing [mm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

