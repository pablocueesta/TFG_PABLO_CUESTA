# =========================
# LIMPIAR DATOS
# =========================

def limpiar_datos(x, y, err=None):
    if err is not None:
        mask = (
            np.isfinite(x) & np.isfinite(y) & np.isfinite(err) &
            (err > 0) & (y > 0) & (y < 1.0) & (err < 0.5)
        )
        return x[mask], y[mask], err[mask]
    else:
        mask = np.isfinite(x) & np.isfinite(y) & (y > 0) & (y < 1.0)
        return x[mask], y[mask]

# =========================
# FIT LINEAL
# =========================

def fit_lineal(x, y, errors):
    x, y, errors = limpiar_datos(x, y, errors)
    if len(x) < 3:
        return None
    params, cov = np.polyfit(x, y, 1, w=1/errors, cov=True)
    a     = params[0]
    b     = params[1]
    err_a = np.sqrt(cov[0,0])
    err_b = np.sqrt(cov[1,1])
    return a, b, err_a, err_b

