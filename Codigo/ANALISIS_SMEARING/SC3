    plt.errorbar(x2, y2, yerr=e2, fmt='s', color='red',  capsize=3, label='sigma2 (cola)')

    res1 = fit_lineal(x1, y1, e1)
    res2 = fit_lineal(x2, y2, e2)

    f_out.write(f"\n--- {titulo} ---\n")

    if res1:
        a1, b1, ea1, eb1 = res1
        xf = np.linspace(min(x1), max(x1), 200)
