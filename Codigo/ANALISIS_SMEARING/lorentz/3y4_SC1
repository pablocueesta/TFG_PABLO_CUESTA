import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit

def aplicar_percentil(data, p=95):
    low  = np.percentile(data, (100-p)/2)
    high = np.percentile(data, 100 - (100-p)/2)
    return data[(data > low) & (data < high)]

def lorentz(x, A, mu, gamma):
    return A / (1 + ((x - mu) / gamma)**2)

def double_lorentz(x, A1, gamma1, A2, gamma2, mu):
    return (A1 / (1 + ((x - mu) / gamma1)**2)
            + A2 / (1 + ((x - mu) / gamma2)**2))

def chi2_reducido(y_data, y_fit, n_params):
    mask = y_data > 0
    residuos = y_data[mask] - y_fit[mask]
    chi2 = np.sum(residuos**2 / y_data[mask])
    ndf  = np.sum(mask) - n_params
    return np.nan if ndf <= 0 else chi2 / ndf


def ejecutar_analisis(sigma_hit):

    np.random.seed(42)
    print(f"\n==============================")
    print(f"Ejecutando sigma_hit = {sigma_hit:.3f}")
    print(f"==============================")

    archivo    = r"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\muon_hits_complete.csv"
    salida_fit = rf"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\Datos\Estudio\Combinado_Lorentz\fits_s{sigma_hit:.3f}.txt"

    df     = pd.read_csv(archivo)
    coords = df[['X','Y','Z']].to_numpy().reshape(-1,4,3)

    coords_smeared = coords.copy()
    valid = coords[:,:,0] != -99999
    coords_smeared[:,:,0][valid] += np.random.normal(0, sigma_hit, np.sum(valid))
    coords_smeared[:,:,2][valid] += np.random.normal(0, sigma_hit, np.sum(valid))
    coords = coords_smeared

    mask     = np.all(coords != -99999, axis=2)
    hits     = mask.sum(axis=1)
    eventos3 = np.where(hits == 3)[0]
    eventos4 = np.where(hits == 4)[0]

    # 3 HITS
    coords3 = coords[eventos3]; mask3 = mask[eventos3]
    coords_validos = np.array([ev[m] for ev,m in zip(coords3,mask3)])
    coords_validos = np.array([ev[np.argsort(ev[:,1])] for ev in coords_validos])
    x3,y3,z3 = coords_validos[:,:,0], coords_validos[:,:,1], coords_validos[:,:,2]
    x_izq,x_mid,x_der = x3.T; y_izq,y_mid,y_der = y3.T; z_izq,z_mid,z_der = z3.T
    m_x = (x_izq-x_der)/(y_izq-y_der); x_teo = m_x*y_mid+(x_izq-m_x*y_izq)
    resX3_full = x_mid - x_teo
    m_z = (z_izq-z_der)/(y_izq-y_der); z_teo = m_z*y_mid+(z_izq-m_z*y_izq)
    resZ3_full = z_mid - z_teo

    # 4 HITS
    combos  = np.array([[0,1,2],[0,1,3],[0,2,3],[1,2,3]])
    coords4 = coords[eventos4]
    coords4 = np.array([ev[np.argsort(ev[:,1])] for ev in coords4])
    coords4 = coords4[:,combos]
    x4,y4,z4 = coords4[:,:,:,0], coords4[:,:,:,1], coords4[:,:,:,2]
    m_x = (x4[:,:,0]-x4[:,:,2])/(y4[:,:,0]-y4[:,:,2])
    x_teo = m_x*y4[:,:,1]+(x4[:,:,0]-m_x*y4[:,:,0])
    resX_all = x4[:,:,1]-x_teo
    resX4_full = resX_all[np.arange(len(resX_all)), np.argmin(np.abs(resX_all),axis=1)]
    m_z = (z4[:,:,0]-z4[:,:,2])/(y4[:,:,0]-y4[:,:,2])
    z_teo = m_z*y4[:,:,1]+(z4[:,:,0]-m_z*y4[:,:,0])
    resZ_all = z4[:,:,1]-z_teo
    resZ4_full = resZ_all[np.arange(len(resZ_all)), np.argmin(np.abs(resZ_all),axis=1)]

    # CAMBIO: percentil 95% dinamico sobre datos completos
    resX3_cut = aplicar_percentil(resX3_full, p=95)
    resZ3_cut = aplicar_percentil(resZ3_full, p=95)
    resX4_cut = aplicar_percentil(resX4_full, p=95)
    resZ4_cut = aplicar_percentil(resZ4_full, p=95)

    # combinado: _cut para fit, _full para fraccion real
    resX_comb_full = np.concatenate([resX3_full, resX4_full])
    resZ_comb_full = np.concatenate([resZ3_full, resZ4_full])
    resX_comb_cut  = aplicar_percentil(np.concatenate([resX3_cut, resX4_cut]), p=95)
    resZ_comb_cut  = aplicar_percentil(np.concatenate([resZ3_cut, resZ4_cut]), p=95)

    # CAMBIO: ventana media +- 3sigma del combinado completo para comparacion
    corte_3sigma_X = (np.mean(resX_comb_full) - 3*np.std(resX_comb_full),
                      np.mean(resX_comb_full) + 3*np.std(resX_comb_full))
    corte_3sigma_Z = (np.mean(resZ_comb_full) - 3*np.std(resZ_comb_full),
                      np.mean(resZ_comb_full) + 3*np.std(resZ_comb_full))

    f_info = open(salida_fit, "w", encoding="utf-8")

    def analizar_combinado(data_fit, data_full, corte_3s, titulo):

        hist, bins = np.histogram(data_fit, bins=60)
        centers    = (bins[:-1] + bins[1:]) / 2
        gamma0     = np.std(data_fit) * 0.5

        # corte p95 sobre data_fit (datos ya cortados) — coincide con el histograma
        corte_p95 = (np.percentile(data_fit, 2.5),
                     np.percentile(data_fit, 97.5))

        # Lorentz simple
        simple_ok = False
        try:
            params_s, cov_s = curve_fit(
                lorentz, centers, hist,
                p0=[max(hist), 0, gamma0],
                bounds=([0,-0.1,0],[np.inf,0.1,np.inf]),
                maxfev=10000)
            A_s, mu_s, gamma_s = [float(p) for p in params_s]
            err_gamma_s = float(np.sqrt(np.diag(cov_s))[2])
            simple_ok = True
        except RuntimeError:
            print(f"  Fit Lorentz simple fallido en {titulo}")
            gamma_s = err_gamma_s = np.nan

        chi2_s = chi2_reducido(hist, lorentz(centers,A_s,mu_s,gamma_s), 3) if simple_ok else np.nan

        # doble Lorentz
        p0_dl = [max(hist), gamma0*0.3, max(hist)/5, gamma0*1.5, 0]
        double_ok = False
        try:
            params_dl, cov_dl = curve_fit(
                double_lorentz, centers, hist,
                p0=p0_dl,
                bounds=([0,0,0,0,-0.1],[np.inf,np.inf,np.inf,np.inf,0.1]),
                maxfev=10000)
            A1,gamma1,A2,gamma2,mu_dl = [float(p) for p in params_dl]
            errors = np.sqrt(np.diag(cov_dl))
            err_gamma1 = float(errors[1]); err_gamma2 = float(errors[3])
            if gamma1 > gamma2:
                A1,A2 = A2,A1; gamma1,gamma2 = gamma2,gamma1
                err_gamma1,err_gamma2 = err_gamma2,err_gamma1
            if 0 < gamma1 < 5 and 0 < gamma2 < 5:
                double_ok = True
            else:
                print(f"  Fit doble no fisico en {titulo}")
        except RuntimeError:
            print(f"  Fit doble fallido en {titulo}")

        if double_ok:
            chi2_dl   = chi2_reducido(hist, double_lorentz(centers,A1,gamma1,A2,gamma2,mu_dl), 5)
            gamma_eff = (A1*gamma1 + A2*gamma2) / (A1 + A2)
        else:
            chi2_dl = gamma_eff = np.nan

        # corte propuesto del fit
        if double_ok and simple_ok and chi2_dl < chi2_s * 0.9:
            gamma_para_corte = gamma_eff
            label_corte      = "gamma_eff (doble Lorentz)"
        elif simple_ok:
            gamma_para_corte = gamma_s
            label_corte      = "gamma_s (Lorentz simple)"
        else:
            gamma_para_corte = np.nan
            label_corte      = "no disponible"

        corte = 5.0 * gamma_para_corte if np.isfinite(gamma_para_corte) else np.nan

        if np.isfinite(corte):
            frac_5g   = np.sum(np.abs(data_full) < corte) / len(data_full) * 100
        else:
            frac_5g = np.nan

        # fraccion dentro de p95 y 3sigma sobre datos completos
        frac_p95   = np.sum((data_full >= corte_p95[0]) &
                             (data_full <= corte_p95[1])) / len(data_full) * 100
        frac_3s    = np.sum((data_full >= corte_3s[0]) &
                             (data_full <= corte_3s[1])) / len(data_full) * 100

        nombre_archivo = titulo.replace(" ","_").replace("(","").replace(")","").replace("+","y")
        base_ruta = rf"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\Plots\Combinado_Lorentz\{nombre_archivo}_{sigma_hit:.3f}"
        x_fit = np.linspace(min(centers), max(centers), 400)

        # plot lineal con zoom al corte del fit
        plt.figure(figsize=(9,6))
        plt.hist(data_fit, bins=60, alpha=0.6, color='steelblue',
                 label=f"Datos (p95)  N={len(data_fit)}")
        if simple_ok:
            plt.plot(x_fit, lorentz(x_fit,A_s,mu_s,gamma_s),
                     color='orange', linewidth=2,
                     label=f"Lorentz simple: gamma={gamma_s:.3f}  chi2/ndf={chi2_s:.2f}")
        if double_ok:
            plt.plot(x_fit, double_lorentz(x_fit,A1,gamma1,A2,gamma2,mu_dl),
                     color='red', linewidth=2, label=f"Doble Lorentz  chi2/ndf={chi2_dl:.2f}")
            plt.plot(x_fit, lorentz(x_fit,A1,mu_dl,gamma1),
                     '--', color='blue', linewidth=1.5, label=f"Core: g1={gamma1:.3f}")
            plt.plot(x_fit, lorentz(x_fit,A2,mu_dl,gamma2),
                     '--', color='green', linewidth=1.5, label=f"Cola: g2={gamma2:.3f}")
        if np.isfinite(corte):
            plt.axvline( corte, color='magenta', linestyle=':', linewidth=1.5,
                         label=f"5*gamma: +-{corte:.3f} mm ({frac_5g:.1f}%)")
            plt.axvline(-corte, color='magenta', linestyle=':', linewidth=1.5)
            plt.xlim(-corte*1.5, corte*1.5)
        # CAMBIO: marcar tambien p95 y 3sigma
        plt.axvline(corte_p95[0], color='orange', linestyle='--', linewidth=1,
                    label=f"p95: +-{abs(corte_p95[0]):.3f} mm ({frac_p95:.1f}%)")
        plt.axvline(corte_p95[1], color='orange', linestyle='--', linewidth=1)
        plt.axvline(corte_3s[0], color='cyan', linestyle='--', linewidth=1,
                    label=f"3sigma: +-{abs(corte_3s[0]):.3f} mm ({frac_3s:.1f}%)")
        plt.axvline(corte_3s[1], color='cyan', linestyle='--', linewidth=1)
        plt.title(titulo); plt.xlabel("Residual [mm]"); plt.ylabel("Counts")
        plt.legend(fontsize=7); plt.grid()
        plt.savefig(base_ruta + "_lineal.png", dpi=150); plt.close()

        # plot logaritmico
        fig, ax = plt.subplots(figsize=(9,6))
        hist_log, bins_log = np.histogram(data_fit, bins=60)
        ctrs_log = (bins_log[:-1]+bins_log[1:])/2
        w_log    = bins_log[1]-bins_log[0]
        ax.bar(ctrs_log[hist_log>0], hist_log[hist_log>0],
               width=w_log, alpha=0.6, color='steelblue',
               label=f"Datos (p95)  N={len(data_fit)}")
        if simple_ok:
            ax.plot(x_fit, lorentz(x_fit,A_s,mu_s,gamma_s),
                    color='orange', linewidth=2,
                    label=f"Lorentz simple: gamma={gamma_s:.3f}  chi2/ndf={chi2_s:.2f}")
        if double_ok:
            ax.plot(x_fit, double_lorentz(x_fit,A1,gamma1,A2,gamma2,mu_dl),
                    color='red', linewidth=2, label=f"Doble Lorentz  chi2/ndf={chi2_dl:.2f}")
            ax.plot(x_fit, lorentz(x_fit,A1,mu_dl,gamma1),
                    '--', color='blue', linewidth=1.5, label=f"Core: g1={gamma1:.3f}")
            ax.plot(x_fit, lorentz(x_fit,A2,mu_dl,gamma2),
                    '--', color='green', linewidth=1.5, label=f"Cola: g2={gamma2:.3f}")
        if np.isfinite(corte):
            ax.axvline( corte, color='magenta', linestyle=':', linewidth=2,
                        label=f"5*gamma: +-{corte:.3f} mm ({frac_5g:.1f}%)")
            ax.axvline(-corte, color='magenta', linestyle=':', linewidth=2)
        ax.axvline(corte_p95[0], color='orange', linestyle='--', linewidth=1,
                   label=f"p95 ({frac_p95:.1f}%)")
        ax.axvline(corte_p95[1], color='orange', linestyle='--', linewidth=1)
        ax.axvline(corte_3s[0], color='cyan', linestyle='--', linewidth=1,
                   label=f"3sigma ({frac_3s:.1f}%)")
        ax.axvline(corte_3s[1], color='cyan', linestyle='--', linewidth=1)
        ax.set_yscale('log')
        ax.set_title(titulo + " [escala logaritmica]")
        ax.set_xlabel("Residual [mm]"); ax.set_ylabel("Counts (log)")
        ax.legend(fontsize=7); ax.grid(which='both', linestyle='--', alpha=0.5)
        fig.savefig(base_ruta + "_log.png", dpi=150); plt.close(fig)

        # guardar
        f_info.write(f"\n--- {titulo} ---\n")
        f_info.write(f"N para fit (p95): {len(data_fit)}  N total: {len(data_full)}\n")
        f_info.write(f"Corte p95:   [{corte_p95[0]:.4f}, {corte_p95[1]:.4f}] mm  ({frac_p95:.1f}% datos totales)\n")
        f_info.write(f"Corte 3sigma:[{corte_3s[0]:.4f}, {corte_3s[1]:.4f}] mm  ({frac_3s:.1f}% datos totales)\n")
        if simple_ok:
            f_info.write(f"Lorentz simple:\n   mu={mu_s:.4f}  gamma={gamma_s:.4f}+-{err_gamma_s:.4f}  chi2/ndf={chi2_s:.4f}\n")
        else:
            f_info.write(f"Lorentz simple: fallido\n")
        if double_ok:
            f_info.write(f"Doble Lorentz:\n   mu={mu_dl:.4f}\n")
            f_info.write(f"   gamma1 (core)={gamma1:.4f}+-{err_gamma1:.4f}\n")
            f_info.write(f"   gamma2 (cola)={gamma2:.4f}+-{err_gamma2:.4f}\n")
            f_info.write(f"   gamma_eff={gamma_eff:.4f}  chi2/ndf={chi2_dl:.4f}\n")
        else:
            f_info.write(f"Doble Lorentz: fallido\n")
        if simple_ok and double_ok:
            decision = "DOBLE LORENTZ MEJOR" if chi2_dl < chi2_s*0.9 else "LORENTZ SIMPLE SUFICIENTE"
            f_info.write(f"Decision: {decision}\n")
            print(f"  {titulo}: chi2_s={chi2_s:.2f} chi2_dl={chi2_dl:.2f} -> {decision}")
        else:
            print(f"  {titulo}: gamma_s={gamma_s:.4f}")
        f_info.write(f"Corte propuesto (5*gamma): {corte:.4f} mm  [{label_corte}]  ({frac_5g:.1f}% datos totales)\n")

    analizar_combinado(resX_comb_cut, resX_comb_full, corte_3sigma_X, "Combinado X (3+4 hits)")
    analizar_combinado(resZ_comb_cut, resZ_comb_full, corte_3sigma_Z, "Combinado Z (3+4 hits)")

    f_info.close()
    print(f"Resultados guardados para sigma={sigma_hit:.3f}")


sigmas = np.arange(0.050, 0.205, 0.005)
for sigma in sigmas:
    try:
        ejecutar_analisis(round(sigma, 3))
    except Exception as e:
        print(f"Error con sigma={sigma:.3f}: {e}")