archivos = glob.glob(os.path.join(carpeta, "fits_s*.txt"))

print(f"Encontrados {len(archivos)} archivos")

pat_gamma_s  = r'gamma=([\d\.]+)\+\-([\d\.]+)'
pat_chi2     = r'chi2/ndf=([\d\.]+)'
pat_gamma1   = r'gamma1 \(core\)=([\d\.]+)\+\-([\d\.]+)'
pat_gamma2   = r'gamma2 \(cola\)=([\d\.]+)\+\-([\d\.]+)'
pat_corte_p95 = (
    r'Corte p95:.*?'
    r'\[\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*\]'
)

def extraer_bloque(contenido, titulo):
    m = re.search(rf'--- {re.escape(titulo)} ---(.*?)(?=\n---|$)', contenido, re.DOTALL)
    return m.group(1) if m else None

def extraer_simple(bloque):
    if not bloque: return ["NaN","NaN","NaN"]
    sub = re.search(r'Lorentz simple:(.*?)(?=Doble|Decision|Corte|$)', bloque, re.DOTALL)
    if not sub: return ["NaN","NaN","NaN"]
    t = sub.group(1)
    g = re.search(pat_gamma_s, t); c = re.search(pat_chi2, t)
    return [g.group(1) if g else "NaN", g.group(2) if g else "NaN",
            c.group(1) if c else "NaN"]

def extraer_doble(bloque):
    if not bloque: return ["NaN"]*5
    sub = re.search(r'Doble Lorentz:(.*?)(?=Decision|Corte|$)', bloque, re.DOTALL)
    if not sub: return ["NaN"]*5
    t = sub.group(1)
    g1 = re.search(pat_gamma1, t); g2 = re.search(pat_gamma2, t); c = re.search(pat_chi2, t)
    return [g1.group(1) if g1 else "NaN", g1.group(2) if g1 else "NaN",
            g2.group(1) if g2 else "NaN", g2.group(2) if g2 else "NaN",
            c.group(1)  if c  else "NaN"]

def extraer_p95(bloque):
    if not bloque: return ["NaN","NaN"]
    m = re.search(pat_corte_p95, bloque)
    return [m.group(1), m.group(2)] if m else ["NaN","NaN"]

with open("todos_los_sigmas.txt", "w", encoding="utf-8") as salida:
    salida.write(
        "sigma_hit\t"
        "X_gamma_s\tX_err_s\tX_chi2_s\t"
        "X_gamma1\tX_err1\tX_gamma2\tX_err2\tX_chi2_dl\t"
        "X_p95_lo\tX_p95_hi\t"
        "Z_gamma_s\tZ_err_s\tZ_chi2_s\t"
        "Z_gamma1\tZ_err1\tZ_gamma2\tZ_err2\tZ_chi2_dl\t"
        "Z_p95_lo\tZ_p95_hi\n"
    )

    for archivo in archivos:
        print(f"Procesando: {archivo}")
        match     = re.search(r"fits_s([\d\.]+)\.txt", archivo)
        sigma_hit = match.group(1) if match else "desconocido"
        try:
            with open(archivo,"r",encoding="utf-8",errors="ignore") as f:
                cont = f.read()
            bx = extraer_bloque(cont, "Combinado X (3+4 hits)")
            bz = extraer_bloque(cont, "Combinado Z (3+4 hits)")
            salida.write(f"{sigma_hit}\t")
            salida.write("\t".join(extraer_simple(bx)) + "\t")
            salida.write("\t".join(extraer_doble(bx))  + "\t")
            salida.write("\t".join(extraer_p95(bx))    + "\t")
            salida.write("\t".join(extraer_simple(bz)) + "\t")
            salida.write("\t".join(extraer_doble(bz))  + "\t")
            salida.write("\t".join(extraer_p95(bz))    + "\n")
        except Exception as e:
            print(f"Error con {archivo}: {e}")
            salida.write(f"{sigma_hit}\t" + "NaN\t"*20 + "\n")

print(f"\nGuardado: {carpeta}\\todos_los_sigmas.txt")