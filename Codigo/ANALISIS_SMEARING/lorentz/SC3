# -------------------------
# PLOT 3 HITS: Lorentziana simple
# -------------------------
def plot_3hits(s_hit, g, err, titulo, nombre):
    x, y, e = limpiar_datos(s_hit, g, err)
    if len(x) < 3:
        return

    plt.figure(figsize=(8,6))
    plt.errorbar(x, y, yerr=e, fmt='o', color='blue', capsize=3,
                 label='gamma (Lorentz simple)')

    res = fit_lineal(x, y, e)
    if res:
        a, b, ea, eb = res
        xf = np.linspace(min(x), max(x), 200)
        plt.plot(xf, a*xf+b, color='blue', linewidth=2,
                 label=f'Fit: a={a:.3f}+-{ea:.3f}, b={b:.4f}+-{eb:.4f}')
        f_out.write(f"\n--- {titulo} ---\n")
        f_out.write(f"gamma: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")
        print(f"{titulo}: a={a:.4f}+-{ea:.4f}")

    plt.xlabel("Smearing [mm]")
    plt.ylabel("gamma experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

# -------------------------
# PLOT 4 HITS: gamma1 + gamma2
# -------------------------
def plot_y_fit(s_hit, g1, e1, g2, e2, titulo, nombre):
    x1, y1, err1 = limpiar_datos(s_hit, g1, e1)
    x2, y2, err2 = limpiar_datos(s_hit, g2, e2)

    plt.figure(figsize=(8,6))
    plt.errorbar(x1, y1, yerr=err1, fmt='o', color='blue', capsize=3, label='gamma1 (core)')
    plt.errorbar(x2, y2, yerr=err2, fmt='s', color='red',  capsize=3, label='gamma2 (cola)')

    f_out.write(f"\n--- {titulo} ---\n")

    res1 = fit_lineal(x1, y1, err1)
    if res1:
        a1, b1, ea1, eb1 = res1
        xf = np.linspace(min(x1), max(x1), 200)
        plt.plot(xf, a1*xf+b1, color='blue', linewidth=2,
                 label=f'Fit gamma1: a={a1:.3f}+-{ea1:.3f}')
        f_out.write(f"gamma1: a={a1:.4f}+-{ea1:.4f}, b={b1:.4f}+-{eb1:.4f}\n")

    res2 = fit_lineal(x2, y2, err2)
    if res2:
        a2, b2, ea2, eb2 = res2
        xf = np.linspace(min(x2), max(x2), 200)
        plt.plot(xf, a2*xf+b2, color='red', linewidth=2,
                 label=f'Fit gamma2: a={a2:.3f}+-{ea2:.3f}')
        f_out.write(f"gamma2: a={a2:.4f}+-{ea2:.4f}, b={b2:.4f}+-{eb2:.4f}\n")

    plt.xlabel("Smearing [mm]")
    plt.ylabel("gamma experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

