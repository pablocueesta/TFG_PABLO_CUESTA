# ordenar gamma1 <= gamma2 para 4 hits
def ordenar_gammas(g1, e1, g2, e2):
    mask    = g1 > g2
    g1n     = g1.copy(); e1n = e1.copy()
    g2n     = g2.copy(); e2n = e2.copy()
    g1n[mask] = g2[mask]; e1n[mask] = e2[mask]
    g2n[mask] = g1[mask]; e2n[mask] = e1[mask]
    return g1n, e1n, g2n, e2n

X4_g1, X4_err1, X4_g2, X4_err2 = ordenar_gammas(X4_g1, X4_err1, X4_g2, X4_err2)
Z4_g1, Z4_err1, Z4_g2, Z4_err2 = ordenar_gammas(Z4_g1, Z4_err1, Z4_g2, Z4_err2)

# -------------------------
# UTILIDADES
# -------------------------
def limpiar_datos(x, y, err):
    mask = (
        np.isfinite(x) & np.isfinite(y) & np.isfinite(err) &
        (err > 0) & (y > 0) & (y < 1.0) & (err < 0.5)
    )
    return x[mask], y[mask], err[mask]

def fit_lineal(x, y, errors):
    x, y, errors = limpiar_datos(x, y, errors)
    if len(x) < 3:
        return None
    params, cov = np.polyfit(x, y, 1, w=1/errors, cov=True)
    return params[0], params[1], np.sqrt(cov[0,0]), np.sqrt(cov[1,1])

