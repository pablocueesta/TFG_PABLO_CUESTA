import os
import re
import glob

carpeta = r"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\Datos\Estudio\First_Cambio_Smearing_Lorentz"
os.chdir(carpeta)

archivos = glob.glob("fits_s*.txt")
archivos.sort()

print(f"Encontrados {len(archivos)} archivos")

pat_gamma_simple = r'gamma = ([\d\.]+) \+\- ([\d\.]+)'
pat_gamma1       = r'gamma1 \(core\) = ([\d\.]+) \+\- ([\d\.]+)'
pat_gamma2       = r'gamma2 \(cola\) = ([\d\.]+) \+\- ([\d\.]+)'
pat_corte_p95    = r'Corte p95: \[([-\d\.]+), ([\d\.]+)\] mm'

def extraer_gamma_simple(bloque):
    if not bloque: return ["NaN","NaN"]
    m = re.search(pat_gamma_simple, bloque.group(1))
    return [m.group(1),m.group(2)] if m else ["NaN","NaN"]

def extraer_gamma_doble(bloque):
    if not bloque: return ["NaN"]*4
    t = bloque.group(1)
    g1 = re.search(pat_gamma1, t); g2 = re.search(pat_gamma2, t)
    return [g1.group(1) if g1 else "NaN", g1.group(2) if g1 else "NaN",
            g2.group(1) if g2 else "NaN", g2.group(2) if g2 else "NaN"]

def extraer_corte_p95(bloque):
    if not bloque: return ["NaN","NaN"]
    m = re.search(pat_corte_p95, bloque.group(1))
    return [m.group(1),m.group(2)] if m else ["NaN","NaN"]

with open("todos_los_sigmas.txt", "w", encoding="utf-8") as salida:
    salida.write(
        "sigma_hit\t"
        "X3_gamma\tX3_err\tX3_p95_lo\tX3_p95_hi\t"
        "Z3_gamma\tZ3_err\tZ3_p95_lo\tZ3_p95_hi\t"
        "X4_gamma1\tX4_err1\tX4_gamma2\tX4_err2\tX4_p95_lo\tX4_p95_hi\t"
        "Z4_gamma1\tZ4_err1\tZ4_gamma2\tZ4_err2\tZ4_p95_lo\tZ4_p95_hi\n"
    )

    for archivo in archivos:
        print(f"Procesando: {archivo}")
        match     = re.search(r"fits_s([\d\.]+)\.txt", archivo)
        sigma_hit = match.group(1) if match else "desconocido"
        try:
            with open(archivo,"r",encoding="utf-8",errors="ignore") as f:
                cont = f.read()

            x3b = re.search(r'--- Residual X \(3 hits\) ---(.*?)---', cont, re.DOTALL)
            z3b = re.search(r'--- Residual Z \(3 hits\) ---(.*?)---', cont, re.DOTALL)
            x4b = re.search(r'--- Residual X \(4 hits\) ---(.*?)---', cont, re.DOTALL)
            z4b = re.search(r'--- Residual Z \(4 hits\) ---(.*?)$',   cont, re.DOTALL)

            salida.write(f"{sigma_hit}\t")
            for b in [x3b, z3b]:
                salida.write("\t".join(extraer_gamma_simple(b)) + "\t")
                salida.write("\t".join(extraer_corte_p95(b))    + "\t")
            for b in [x4b, z4b]:
                salida.write("\t".join(extraer_gamma_doble(b))  + "\t")
                salida.write("\t".join(extraer_corte_p95(b))    + "\t")
            salida.write("\n")
        except Exception as e:
            print(f"Error con {archivo}: {e}")
            salida.write(f"{sigma_hit}\t" + "NaN\t"*20 + "\n")

print(f"\nGuardado: {carpeta}\\todos_los_sigmas.txt")