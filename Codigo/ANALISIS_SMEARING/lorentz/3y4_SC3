def plot_comparacion(s_hit, gs,es, g1,e1, g2,e2, chi2s,chi2dl, p95_ancho, titulo, nombre):

    fig, (ax1, ax2, ax3) = plt.subplots(3,1,figsize=(9,14),sharex=True)
    fig.suptitle(titulo)

    xs,ys,ees = limpiar(s_hit,gs,es)
    x1,y1,ee1 = limpiar(s_hit,g1,e1)
    x2,y2,ee2 = limpiar(s_hit,g2,e2)
    xcs,ycs   = limpiar(s_hit,chi2s)
    xcd,ycd   = limpiar(s_hit,chi2dl)
    xc,yc     = limpiar(s_hit,p95_ancho)

    # panel 1: gammas
    ax1.errorbar(xs,ys,yerr=ees,fmt='o',color='orange',capsize=3,label='gamma simple')
    ax1.errorbar(x1,y1,yerr=ee1,fmt='o',color='blue',  capsize=3,label='gamma1 (core)')
    ax1.errorbar(x2,y2,yerr=ee2,fmt='s',color='red',   capsize=3,label='gamma2 (cola)')
    f_out.write(f"\n--- {titulo} ---\n")
    for (x,y,e,color,etiq) in [(xs,ys,ees,'orange','gamma_simple'),
                                (x1,y1,ee1,'blue','gamma1'),
                                (x2,y2,ee2,'red','gamma2')]:
        res = fit_lineal(x,y,e)
        if res:
            a,b,ea,eb = res
            xf = np.linspace(min(x),max(x),200)
            ax1.plot(xf,a*xf+b,color=color,linewidth=2,
                     label=f'Fit {etiq}: a={a:.3f}+-{ea:.3f}')
            f_out.write(f"{etiq}: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")
    ax1.set_ylabel("gamma [mm]"); ax1.legend(fontsize=8); ax1.grid()

    # panel 2: chi2
    ax2.plot(xcs,ycs,'o-',color='orange',label='chi2/ndf Lorentz simple')
    ax2.plot(xcd,ycd,'s-',color='red',   label='chi2/ndf Doble Lorentz')
    ax2.axhline(1.0,color='black',linestyle='--',linewidth=1,label='chi2/ndf=1')
    ax2.set_ylabel("chi2/ndf"); ax2.set_title("Calidad del ajuste")
    ax2.legend(fontsize=8); ax2.grid()

    # panel 3: ventana p95
    ax3.plot(xc,yc,'D-',color='magenta',linewidth=2,label='Semiancho p95')
    if len(xc)>=3:
        #p2 = np.polyfit(xc,yc,1)
        xf = np.linspace(min(xc),max(xc),200)
        #ax3.plot(xf,p2[0]*xf+p2[1],'--',color='darkviolet',linewidth=2,
                 #label=f'Fit: a={p2[0]:.4f}, b={p2[1]:.4f}')
        #f_out.write(f"p95_semiancho: a={p2[0]:.4f}, b={p2[1]:.4f}\n")
    ax3.set_xlabel("Smearing [mm]"); ax3.set_ylabel("Semiancho p95 [mm]")
    ax3.set_title("Ventana de ajuste (semiancho p95) vs smearing")
    ax3.legend(fontsize=8); ax3.grid()

    plt.tight_layout()
    plt.savefig(os.path.join(out_dir,f"{nombre}.png"),dpi=200); plt.close()
    print(f"Guardado: {nombre}.png")

