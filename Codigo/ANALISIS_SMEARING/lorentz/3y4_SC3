# -------------------------
# PLOT: gamma simple vs doble + chi2 + corte propuesto
# -------------------------

def plot_comparacion(s_hit, gs, es, g1, e1, g2, e2, chi2s, chi2dl, corte, titulo, nombre):

    xs, ys, ees   = limpiar(s_hit, gs,  es)
    x1, y1, ee1   = limpiar(s_hit, g1,  e1)
    x2, y2, ee2   = limpiar(s_hit, g2,  e2)
    xcs, ycs      = limpiar(s_hit, chi2s)
    xcd, ycd      = limpiar(s_hit, chi2dl)

    # Limpiar corte: solo finitos y positivos
    mask_c = np.isfinite(s_hit) & np.isfinite(corte) & (corte > 0)
    xc_plot = s_hit[mask_c]
    yc_plot = corte[mask_c]

    # 3 paneles: gammas | chi2 | corte propuesto
    fig, (ax1, ax2, ax3) = plt.subplots(3, 1, figsize=(9, 14), sharex=True)

    # --- panel 1: gammas ---
    ax1.errorbar(xs, ys, yerr=ees, fmt='o', color='orange', capsize=3,
                 label='Lorentz simple: gamma')
    ax1.errorbar(x1, y1, yerr=ee1, fmt='o', color='blue',   capsize=3,
                 label='Doble Lorentz: gamma1 (core)')
    ax1.errorbar(x2, y2, yerr=ee2, fmt='s', color='red',    capsize=3,
                 label='Doble Lorentz: gamma2 (cola)')

    f_out.write(f"\n--- {titulo} ---\n")

    for (x, y, e, color, etiq) in [
        (xs, ys, ees, 'orange', 'gamma_simple'),
        (x1, y1, ee1, 'blue',   'gamma1'),
        (x2, y2, ee2, 'red',    'gamma2')
    ]:
        res = fit_lineal(x, y, e)
        if res:
            a, b, ea, eb = res
            xf = np.linspace(min(x), max(x), 200)
            ax1.plot(xf, a*xf+b, color=color, linewidth=2,
                     label=f'Fit {etiq}: a={a:.3f}+-{ea:.3f}')
            f_out.write(f"{etiq}: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")

    ax1.set_ylabel("gamma [mm]")
    ax1.set_title(titulo)
    ax1.legend(fontsize=8)
    ax1.grid()

    # --- panel 2: chi2 reducido ---
    ax2.plot(xcs, ycs, 'o-', color='orange', label='chi2/ndf Lorentz simple')
    ax2.plot(xcd, ycd, 's-', color='red',    label='chi2/ndf Doble Lorentz')
    ax2.axhline(1.0, color='black', linestyle='--', linewidth=1, label='chi2/ndf = 1 (ideal)')
    ax2.set_ylabel("chi2 / ndf")
    ax2.set_title("Calidad del ajuste")
    ax2.legend(fontsize=8)
    ax2.grid()

    # --- panel 3: corte propuesto (5·gamma) vs smearing ---
    ax3.plot(xc_plot, yc_plot, 'D-', color='magenta', linewidth=2,
             label='Corte propuesto = 5·gamma [mm]')

    # Fit lineal del corte vs smearing
    if len(xc_plot) >= 3:
        params_c = np.polyfit(xc_plot, yc_plot, 1)
        xf_c = np.linspace(min(xc_plot), max(xc_plot), 200)
        ax3.plot(xf_c, np.polyval(params_c, xf_c),
                 color='darkviolet', linestyle='--', linewidth=2,
                 label=f'Fit lineal: a={params_c[0]:.3f}, b={params_c[1]:.3f}')
        f_out.write(f"corte_propuesto: a={params_c[0]:.4f}, b={params_c[1]:.4f}\n")

    ax3.set_xlabel("Smearing [mm]")
    ax3.set_ylabel("Corte propuesto [mm]")
    #ax3.set_ylim(0.1, 0.4)
    ax3.set_title("Ventana de ajuste propuesta (5·gamma) vs smearing")
    ax3.legend(fontsize=8)
    ax3.grid()

    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=200)
    plt.close()
    print(f"Guardado: {nombre}.png")

