# -------------------------
# UTILIDADES
# -------------------------

def limpiar(x, y, err=None):
    if err is not None:
        mask = np.isfinite(x) & np.isfinite(y) & np.isfinite(err) & (err > 0) & (y > 0) & (y < 2.0)
        return x[mask], y[mask], err[mask]
    else:
        # CORRECCIÓN: el filtro anterior (y < 20) excluía chi² perfectamente
        # válidos en distribuciones con muchos bins. Se amplía a 200 para no
        # descartar puntos legítimos; los outliers reales se ven en el plot.
        mask = np.isfinite(x) & np.isfinite(y) & (y > 0) & (y < 200.0)
        return x[mask], y[mask]

def fit_lineal(x, y, e):
    x, y, e = limpiar(x, y, e)
    if len(x) < 3:
        return None
    params, cov = np.polyfit(x, y, 1, w=1/e, cov=True)
    return params[0], params[1], np.sqrt(cov[0,0]), np.sqrt(cov[1,1])

