# -------------------------
# PLOT 3 HITS: gaussiana simple
# -------------------------
def plot_3hits(D, sg, err, titulo, nombre):
    x, y, e = limpiar_datos(D, sg, err)
    if len(x) < 3:
        print(f"Pocos puntos para {titulo}")
        return

    plt.figure(figsize=(8,6))
    plt.errorbar(x, y, yerr=e, fmt='o', color='blue', capsize=3,
                 label='sigma (gaussiana simple)')

    res = fit_lineal(x, y, e)
    if res:
        a, b, ea, eb = res
        xf = np.linspace(min(x), max(x), 200)
        plt.plot(xf, a*xf+b, color='blue', linewidth=2,
                 label=f'Fit: a={a:.4f}+-{ea:.4f}')
        f_out.write(f"\n--- {titulo} ---\n")
        f_out.write(f"sigma: a={a:.4f}+-{ea:.4f}, b={b:.4f}+-{eb:.4f}\n")
        print(f"{titulo}: a={a:.4f}+-{ea:.4f}")

    plt.xlabel("D [cm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.legend()
    plt.grid()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()

# -------------------------
# PLOT 4 HITS: sigma1 + sigma2
# -------------------------
def plot_y_fit(D, sg1, err1, sg2, err2, titulo, nombre):
    x1, y1, e1 = limpiar_datos(D, sg1, err1)
    x2, y2, e2 = limpiar_datos(D, sg2, err2)

    plt.figure(figsize=(8,6))
    plt.errorbar(x1, y1, yerr=e1, fmt='o', color='blue', capsize=3, label='sigma1 (core)')
    plt.errorbar(x2, y2, yerr=e2, fmt='s', color='red',  capsize=3, label='sigma2 (cola)')

    f_out.write(f"\n--- {titulo} ---\n")

    res1 = fit_lineal(x1, y1, e1)
    if res1:
        a1, b1, ea1, eb1 = res1
        xf = np.linspace(min(x1), max(x1), 200)
        plt.plot(xf, a1*xf+b1, color='blue', linewidth=2,
                 label=f'Fit sigma1: a={a1:.4f}+-{ea1:.4f}')
        f_out.write(f"sigma1: a={a1:.4f}+-{ea1:.4f}, b={b1:.4f}+-{eb1:.4f}\n")

    res2 = fit_lineal(x2, y2, e2)
    if res2:
        a2, b2, ea2, eb2 = res2
        xf = np.linspace(min(x2), max(x2), 200)
        plt.plot(xf, a2*xf+b2, color='red', linewidth=2,
                 label=f'Fit sigma2: a={a2:.4f}+-{ea2:.4f}')
        f_out.write(f"sigma2: a={a2:.4f}+-{ea2:.4f}, b={b2:.4f}+-{eb2:.4f}\n")

    plt.xlabel("D [cm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.legend()
    plt.grid()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=300)
    plt.close()
    print(f"Guardado: {nombre}.png")

