# CAMBIO: ordenar sigma1 <= sigma2 para 4 hits (con errores)
def ordenar_sigmas(sg1, err1, sg2, err2):
    mask     = sg1 > sg2
    sg1_new  = sg1.copy();  err1_new = err1.copy()
    sg2_new  = sg2.copy();  err2_new = err2.copy()
    sg1_new[mask]  = sg2[mask];  err1_new[mask] = err2[mask]
    sg2_new[mask]  = sg1[mask];  err2_new[mask] = err1[mask]
    return sg1_new, err1_new, sg2_new, err2_new

X4_sg1, X4_err1, X4_sg2, X4_err2 = ordenar_sigmas(X4_sg1, X4_err1, X4_sg2, X4_err2)
Z4_sg1, Z4_err1, Z4_sg2, Z4_err2 = ordenar_sigmas(Z4_sg1, Z4_err1, Z4_sg2, Z4_err2)

# -------------------------
# LIMPIAR DATOS
# -------------------------
def limpiar_datos(x, y, err=None):
    if err is not None:
        mask = (
            np.isfinite(x) & np.isfinite(y) & np.isfinite(err) &
            (err > 0) & (err/y < 1.0) & (err < 10.0)
        )
        return x[mask], y[mask], err[mask]
    else:
        mask = np.isfinite(x) & np.isfinite(y) & (y > 0)
        return x[mask], y[mask]

# -------------------------
# FIT LINEAL
# -------------------------
def fit_lineal(x, y, errors):
    x, y, errors = limpiar_datos(x, y, errors)
    if len(x) < 3:
        return None
    params, cov = np.polyfit(x, y, 1, w=1/errors, cov=True)
    return params[0], params[1], np.sqrt(cov[0,0]), np.sqrt(cov[1,1])

