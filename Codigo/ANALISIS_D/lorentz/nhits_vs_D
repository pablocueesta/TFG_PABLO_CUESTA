import numpy as np
import matplotlib.pyplot as plt
import os

BASE     = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', '..'))
archivo  = os.path.join(BASE, "Datos", "Estudio", "nhits_vs_D.txt")
RUTA     = os.path.join(BASE, "Plots")

data = np.loadtxt(archivo, skiprows=1)
D       = data[:,0]
N_total = data[:,1]
N3      = data[:,2]
N4      = data[:,3]
pct3    = data[:,4]
pct4    = data[:,5]

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
fig.suptitle("Estadística de trayectorias en función de D")

# panel izquierdo: numero total y desglose 3/4 hits
ax1.plot(D, N_total, 'ko-', linewidth=2, markersize=6, label="Total")
ax1.plot(D, N3, 'bs--', linewidth=1.5, markersize=5, label="3 hits")
ax1.plot(D, N4, 'r^--', linewidth=1.5, markersize=5, label="4 hits")
ax1.set_xlabel("D [cm]")
ax1.set_ylabel("Número de trayectorias")
ax1.set_title("Número de trayectorias vs D")
ax1.legend(fontsize=9)
ax1.grid(linestyle='--', alpha=0.5)

# panel derecho: porcentaje de 4 hits
ax2.plot(D, pct4, 'r^-', linewidth=2, markersize=6, label="% 4 hits")
ax2.plot(D, pct3, 'bs-', linewidth=2, markersize=6, label="% 3 hits")
ax2.axhline(50, color='gray', linestyle=':', linewidth=1)
ax2.set_xlabel("D [cm]")
ax2.set_ylabel("Fracción de trayectorias [%]")
ax2.set_title("Fracción de trayectorias 3 y 4 hits vs D")
ax2.legend(fontsize=9)
ax2.grid(linestyle='--', alpha=0.5)
ax2.set_ylim(0, 100)

fig.tight_layout()
fig.savefig(os.path.join(RUTA, "nhits_vs_D.png"), dpi=200)
plt.close(fig)
print("Guardado: nhits_vs_D.png")