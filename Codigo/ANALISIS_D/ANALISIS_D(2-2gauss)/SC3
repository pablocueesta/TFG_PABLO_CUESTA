# -------------------------
# FUNCIÓN PLOT + FIT
# -------------------------
def plot_y_fit(D, sg1, err1, sg2, err2, titulo, nombre):

    D1, y1, e1 = limpiar_datos(D, sg1, err1)
    D2, y2, e2 = limpiar_datos(D, sg2, err2)

    plt.figure(figsize=(8,6))

    plt.errorbar(D1, y1, yerr=e1, fmt='o', color='blue', capsize=3, label='sigma1 (core)')
    plt.errorbar(D2, y2, yerr=e2, fmt='s', color='red',  capsize=3, label='sigma2 (cola)')

    f_out.write(f"\n--- {titulo} ---\n")

    res1 = fit_lineal(D1, y1, e1)
    if res1:
        a1, b1, ea1, eb1 = res1
        xf = np.linspace(min(D1), max(D1), 200)
        plt.plot(xf, a1*xf+b1, color='blue', linewidth=2,
                 label=f'Fit sigma1: a={a1:.3f}+-{ea1:.3f}')
        f_out.write(f"sigma1: a={a1:.4f}+-{ea1:.4f}, b={b1:.4f}+-{eb1:.4f}\n")
        print(f"{titulo} | sigma1: a={a1:.4f}+-{ea1:.4f}")

    res2 = fit_lineal(D2, y2, e2)
    if res2:
        a2, b2, ea2, eb2 = res2
        xf = np.linspace(min(D2), max(D2), 200)
        plt.plot(xf, a2*xf+b2, color='red', linewidth=2,
                 label=f'Fit sigma2: a={a2:.3f}+-{ea2:.3f}')
        f_out.write(f"sigma2: a={a2:.4f}+-{ea2:.4f}, b={b2:.4f}+-{eb2:.4f}\n")
        print(f"{titulo} | sigma2: a={a2:.4f}+-{ea2:.4f}")

    plt.xlabel("D [cm]")
    plt.ylabel("Resolucion experimental [mm]")
    plt.title(titulo)
    plt.legend()
    plt.grid()

    ruta = os.path.join(out_dir, f"{nombre}.png")
    plt.savefig(ruta, dpi=300)
    plt.close()

