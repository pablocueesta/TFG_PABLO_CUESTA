# -------------------------
# ORDENAR SIGMAS (core < cola)
# CAMBIO: ahora también intercambia los errores
# -------------------------
def ordenar_sigmas(sg1, err1, sg2, err2):
    mask = sg1 > sg2  # donde sigma1 es mayor que sigma2 hay que intercambiar

    sg1_new  = sg1.copy()
    err1_new = err1.copy()
    sg2_new  = sg2.copy()
    err2_new = err2.copy()

    sg1_new[mask]  = sg2[mask]
    err1_new[mask] = err2[mask]
    sg2_new[mask]  = sg1[mask]
    err2_new[mask] = err1[mask]

    return sg1_new, err1_new, sg2_new, err2_new

X3_sg1, X3_err1, X3_sg2, X3_err2 = ordenar_sigmas(X3_sg1, X3_err1, X3_sg2, X3_err2)
Z3_sg1, Z3_err1, Z3_sg2, Z3_err2 = ordenar_sigmas(Z3_sg1, Z3_err1, Z3_sg2, Z3_err2)
X4_sg1, X4_err1, X4_sg2, X4_err2 = ordenar_sigmas(X4_sg1, X4_err1, X4_sg2, X4_err2)
