def limpiar(x, y, e=None):
    if e is not None:
        mask = np.isfinite(x)&np.isfinite(y)&np.isfinite(e)&(e>0)&(y>0)&(y<5)
        return x[mask],y[mask],e[mask]
    mask = np.isfinite(x)&np.isfinite(y)&(y>0)
    return x[mask],y[mask]

# ── MAPA DE COLOR ────────────────────────────────────────────────────────────
def mapa_color(D, ang, valores, D_vals, ang_vals, titulo, nombre, unidad="mm"):
    """
    Dibuja un mapa de color con D en eje X y ang en eje Y.
    valores: array de len(D_vals)*len(ang_vals) en el mismo orden que data
    """
    nD  = len(D_vals)
    nA  = len(ang_vals)
    Z   = np.full((nA, nD), np.nan)

    for i, d in enumerate(D_vals):
        for j, a in enumerate(ang_vals):
            mask = (D == d) & (ang == a)
            if mask.sum() == 1 and np.isfinite(valores[mask][0]) and valores[mask][0] > 0:
                Z[j, i] = valores[mask][0]

    fig, ax = plt.subplots(figsize=(7,5))
    im = ax.imshow(Z, aspect='auto', origin='lower',
                   extent=[D_vals[0]-3, D_vals[-1]+3,
                           ang_vals[0]-5, ang_vals[-1]+5],
                   cmap='RdYlBu_r', interpolation='nearest')
    cbar = fig.colorbar(im, ax=ax)
    cbar.set_label(f"{titulo} [{unidad}]", fontsize=10)

    # anotar valor en cada celda
    for i, d in enumerate(D_vals):
        for j, a in enumerate(ang_vals):
            v = Z[j, i]
            if np.isfinite(v):
                ax.text(d, a, f"{v:.3f}", ha='center', va='center',
                        fontsize=8, color='black',
                        bbox=dict(boxstyle='round,pad=0.1', fc='white', alpha=0.5))

    ax.set_xticks(D_vals); ax.set_xticklabels([f"{d:.0f}" for d in D_vals])
    ax.set_yticks(ang_vals); ax.set_yticklabels([f"{a:.0f}" for a in ang_vals])
    ax.set_xlabel("D [cm]"); ax.set_ylabel("Ángulo [grados]")
    ax.set_title(titulo)
    fig.tight_layout()
    fig.savefig(os.path.join(out_mapas, f"{nombre}.png"), dpi=200)
    plt.close(fig)
    print(f"Mapa guardado: {nombre}.png")

# ── PLOTS EVOLUCIÓN (fijando una variable y variando la otra) ────────────────
def plot_evolucion(D, ang, gamma, err, p95_ancho, D_vals, ang_vals,
                   titulo_base, nombre_base, xlabel, xvals, fijo_label, fijo_vals,
                   fijo_arr, libre_arr):
    """
    Para cada valor fijo de una variable, plotea gamma y ventana vs la otra.
    """
    colores = ['blue','red','green','orange']
    for idx, fijo in enumerate(fijo_vals):
        mask_fijo = fijo_arr == fijo
        x  = libre_arr[mask_fijo]
        g  = gamma[mask_fijo]
        e  = err[mask_fijo]
        p  = p95_ancho[mask_fijo]

        # ordenar por x
        orden = np.argsort(x)
        x,g,e,p = x[orden],g[orden],e[orden],p[orden]

        # filtrar NaN e invalidos
        mask_ok = np.isfinite(g)&np.isfinite(e)&(e>0)&(g>0)&(g<5)
        if mask_ok.sum() < 2: continue

        fig,(ax1,ax2) = plt.subplots(2,1,figsize=(8,9),sharex=True)
        fig.suptitle(f"{titulo_base}\n{fijo_label}={fijo}")

        ax1.errorbar(x[mask_ok], g[mask_ok], yerr=e[mask_ok],
                     fmt='o-', color=colores[idx%4], capsize=3, label='gamma')
        ax1.set_ylabel("gamma [mm]"); ax1.legend(fontsize=8); ax1.grid()

        mask_p = np.isfinite(p)&(p>0)
        ax2.plot(x[mask_p], p[mask_p], 'D-', color=colores[idx%4],
                 linewidth=2, label='Semiancho p95')
        ax2.set_xlabel(xlabel); ax2.set_ylabel("Semiancho p95 [mm]")
        ax2.set_title("Ventana de ajuste vs "+xlabel)
        ax2.legend(fontsize=8); ax2.grid()

        plt.tight_layout()
        plt.savefig(os.path.join(out_plots,
                    f"{nombre_base}_{fijo_label}{fijo:.0f}.png"), dpi=150)
        plt.close()
        print(f"Guardado: {nombre_base}_{fijo_label}{fijo:.0f}.png")

