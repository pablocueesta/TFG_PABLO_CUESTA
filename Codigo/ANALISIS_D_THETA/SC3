# evita el problema del blanco central de RdYlBu_r
CMAP = LinearSegmentedColormap.from_list('br_purple',
    ['#1a53ff', '#7a00cc', '#cc0000'])

def limpiar(x, y, e=None):
    if e is not None:
        mask = np.isfinite(x)&np.isfinite(y)&np.isfinite(e)&(e>0)&(y>0)&(y<5)
        return x[mask],y[mask],e[mask]
    mask = np.isfinite(x)&np.isfinite(y)&(y>0)
    return x[mask],y[mask]

def get_nominal(valores, D, ang, D_nom, ang_nom):
    """Obtiene el valor nominal en (D_nom, ang_nom)."""
    mask = (D == D_nom) & (ang == ang_nom)
    if mask.sum() == 1 and np.isfinite(valores[mask][0]) and valores[mask][0] > 0:
        return valores[mask][0]
    return np.nan

def mapa_color(D, ang, valores, D_vals, ang_vals, titulo, nombre):
    """
    Mapa de color con PUNTOS (scatter) en lugar de cuadrados (imshow).
    Los valores se normalizan al valor en (D=13cm, ang=0) = 1.
    Colormap azul->purpura->rojo sin blanco en el centro.
    El valor anotado en cada punto es el porcentaje respecto al nominal.
    """
    # valor nominal para normalizar
    v_nom = get_nominal(valores, D, ang, D_nom, ang_nom)
    if np.isnan(v_nom):
        print(f"  AVISO: no hay valor nominal para {titulo}, saltando")
        return

    # construir arrays de puntos validos
    xs, ys, vs, ns = [], [], [], []
    for i, d in enumerate(D_vals):
        for j, a in enumerate(ang_vals):
            mask = (D == d) & (ang == a)
            if mask.sum() == 1:
                v = valores[mask][0]
                if np.isfinite(v) and v > 0:
                    xs.append(d)
                    ys.append(a)
                    vs.append(v)
                    ns.append(v / v_nom)  # normalizado

    if len(xs) == 0:
        print(f"  AVISO: sin datos validos para {titulo}")
        return

    xs = np.array(xs); ys = np.array(ys)
    vs = np.array(vs); ns = np.array(ns)

    # escala centrada en 1 (nominal), simetrica
    desv_max = max(abs(ns.max() - 1), abs(ns.min() - 1))
    if desv_max < 0.01: desv_max = 0.01  # minimo para evitar escala plana
    vmin = 1 - desv_max * 1.1
    vmax = 1 + desv_max * 1.1
    norm = TwoSlopeNorm(vcenter=1.0, vmin=vmin, vmax=vmax)

    fig, ax = plt.subplots(figsize=(7, 5))
    ax.set_facecolor('#f5f5f5')  # fondo gris muy claro

    # dibujar puntos grandes con el color de la normalizacion
    sc = ax.scatter(xs, ys, c=ns, cmap=CMAP, norm=norm,
                    s=1200, zorder=3, edgecolors='gray', linewidths=0.5)

    # anotar: valor real y porcentaje respecto al nominal
    for xi, yi, vi, ni in zip(xs, ys, vs, ns):
        pct = (ni - 1) * 100
        sign = '+' if pct >= 0 else ''
        ax.text(xi, yi + 1.5, f"{vi:.3f}", ha='center', va='center',
                fontsize=7.5, color='black', fontweight='bold', zorder=4)
        ax.text(xi, yi - 1.5, f"({sign}{pct:.1f}%)", ha='center', va='center',
                fontsize=6.5, color='#333333', zorder=4)

    cbar = fig.colorbar(sc, ax=ax)
    cbar.set_label(f"Valor normalizado al nominal\n(D={D_nom:.0f}cm, θ=0°)", fontsize=9)

    ax.set_xticks(D_vals); ax.set_xticklabels([f"{d:.0f}" for d in D_vals])
    ax.set_yticks(ang_vals); ax.set_yticklabels([f"{a:.0f}" for a in ang_vals])
    ax.set_xlim(D_vals[0]-4, D_vals[-1]+4)
    ax.set_ylim(ang_vals[0]-8, ang_vals[-1]+8)
    ax.set_xlabel("D (cm)"); ax.set_ylabel("θ (°)")
    ax.set_title(titulo)
    fig.tight_layout()
    fig.savefig(os.path.join(out_mapas, f"{nombre}.png"), dpi=200)
    plt.close(fig)
    print(f"Mapa guardado: {nombre}.png")

def plot_evolucion(D, ang, gamma, err, p95_ancho, D_vals, ang_vals,
                   titulo_base, nombre_base, xlabel, fijo_label, fijo_vals,
                   fijo_arr, libre_arr):
    colores = ['blue','red','green','orange']
    for idx, fijo in enumerate(fijo_vals):
        mask_fijo = fijo_arr == fijo
        x  = libre_arr[mask_fijo]
        g  = gamma[mask_fijo]
        e  = err[mask_fijo]
        p  = p95_ancho[mask_fijo]
        orden = np.argsort(x)
        x,g,e,p = x[orden],g[orden],e[orden],p[orden]
        mask_ok = np.isfinite(g)&np.isfinite(e)&(e>0)&(g>0)&(g<5)
        if mask_ok.sum() < 2: continue

        fig,(ax1,ax2) = plt.subplots(2,1,figsize=(8,9),sharex=True)
        fig.suptitle(f"{titulo_base}\n{fijo_label}={fijo}")
        ax1.errorbar(x[mask_ok], g[mask_ok], yerr=e[mask_ok],
                     fmt='o-', color=colores[idx%4], capsize=3, label='gamma')
        ax1.set_ylabel("gamma [mm]"); ax1.legend(fontsize=8); ax1.grid()
        mask_p = np.isfinite(p)&(p>0)
        ax2.plot(x[mask_p], p[mask_p], 'D-', color=colores[idx%4],
                 linewidth=2, label='Semiancho p95')
        ax2.set_xlabel(xlabel); ax2.set_ylabel("Semiancho p95 [mm]")
        ax2.set_title("Ventana de ajuste vs "+xlabel)
        ax2.legend(fontsize=8); ax2.grid()
        plt.tight_layout()
        plt.savefig(os.path.join(out_plots,
                    f"{nombre_base}_{fijo_label}{fijo:.0f}.png"), dpi=150)
        plt.close()
        print(f"Guardado: {nombre_base}_{fijo_label}{fijo:.0f}.png")

