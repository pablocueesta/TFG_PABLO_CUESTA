import numpy as np
import matplotlib.pyplot as plt
import os

BASE    = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                        '..', '..'))
carpeta = os.path.join(BASE, "Datos", "Estudio", "D_Ang_Combinado_Lorentz")
out_plots = os.path.join(carpeta, "plots_D_Ang")
out_mapas = os.path.join(carpeta, "mapas_color")
os.makedirs(out_plots, exist_ok=True)
os.makedirs(out_mapas, exist_ok=True)

data = np.loadtxt(os.path.join(carpeta, "todos_D_ang.txt"), skiprows=1)

# columnas:
# [0] D   [1] ang
# [2] X_gamma_s  [3] X_err_s
# [4] X_gamma1   [5] X_err1
# [6] X_gamma2   [7] X_err2
# [8] X_gamma_eff
# [9] X_p95_lo   [10] X_p95_hi
# [11] Z_gamma_s [12] Z_err_s
# [13] Z_gamma1  [14] Z_err1
# [15] Z_gamma2  [16] Z_err2
# [17] Z_gamma_eff
# [18] Z_p95_lo  [19] Z_p95_hi

D_vals  = np.array([7.0, 13.0, 20.0, 30.0])
ang_vals= np.array([0,   20,   40,   60])

D    = data[:,0];  ang  = data[:,1]
X_gs = data[:,2];  X_es = data[:,3]
X_g1 = data[:,4];  X_e1 = data[:,5]
X_g2 = data[:,6];  X_e2 = data[:,7];  X_ge  = data[:,8]
X_p95= (data[:,10]-data[:,9])/2
Z_gs = data[:,11]; Z_es = data[:,12]
Z_g1 = data[:,13]; Z_e1 = data[:,14]
Z_g2 = data[:,15]; Z_e2 = data[:,16]; Z_ge  = data[:,17]
Z_p95= (data[:,19]-data[:,18])/2

def mapa_color(D, ang, valores, D_vals, ang_vals, titulo, nombre):
    nD = len(D_vals); nA = len(ang_vals)
    Z  = np.full((nA, nD), np.nan)
    for i,d in enumerate(D_vals):
        for j,a in enumerate(ang_vals):
            mask = (D==d)&(ang==a)
            if mask.sum()==1 and np.isfinite(valores[mask][0]) and valores[mask][0]>0:
                Z[j,i] = valores[mask][0]

    fig, ax = plt.subplots(figsize=(7,5))
    im = ax.imshow(Z, aspect='auto', origin='lower',
                   extent=[D_vals[0]-3, D_vals[-1]+3,
                           ang_vals[0]-5, ang_vals[-1]+5],
                   cmap='RdYlBu_r', interpolation='nearest')
    cbar = fig.colorbar(im, ax=ax)
    cbar.set_label(f"{titulo} [mm]", fontsize=10)

    for i,d in enumerate(D_vals):
        for j,a in enumerate(ang_vals):
            v = Z[j,i]
            if np.isfinite(v):
                ax.text(d, a, f"{v:.3f}", ha='center', va='center',
                        fontsize=8, color='black',
                        bbox=dict(boxstyle='round,pad=0.1', fc='white', alpha=0.5))

    ax.set_xticks(D_vals); ax.set_xticklabels([f"{d:.0f}" for d in D_vals])
    ax.set_yticks(ang_vals); ax.set_yticklabels([f"{a:.0f}" for a in ang_vals])
    ax.set_xlabel("D [cm]"); ax.set_ylabel("Ángulo [grados]")
    ax.set_title(titulo)
    fig.tight_layout()
    fig.savefig(os.path.join(out_mapas, f"{nombre}.png"), dpi=200)
    plt.close(fig)
    print(f"Mapa guardado: {nombre}.png")

def plot_evolucion(D, ang, gamma, err, p95_ancho, D_vals, ang_vals,
                   titulo_base, nombre_base, xlabel, fijo_label, fijo_vals,
                   fijo_arr, libre_arr):
    colores = ['blue','red','green','orange']
    for idx, fijo in enumerate(fijo_vals):
        mask_fijo = fijo_arr == fijo
        x = libre_arr[mask_fijo]; g = gamma[mask_fijo]
        e = err[mask_fijo];       p = p95_ancho[mask_fijo]
        orden = np.argsort(x)
        x,g,e,p = x[orden],g[orden],e[orden],p[orden]
        mask_ok = np.isfinite(g)&np.isfinite(e)&(e>0)&(g>0)&(g<5)
        if mask_ok.sum() < 2: continue

        fig,(ax1,ax2) = plt.subplots(2,1,figsize=(8,9),sharex=True)
        fig.suptitle(f"{titulo_base}\n{fijo_label}={fijo}")
        ax1.errorbar(x[mask_ok], g[mask_ok], yerr=e[mask_ok],
                     fmt='o-', color=colores[idx%4], capsize=3, label='gamma')
        ax1.set_ylabel("gamma [mm]"); ax1.legend(fontsize=8); ax1.grid()
        mask_p = np.isfinite(p)&(p>0)
        ax2.plot(x[mask_p], p[mask_p], 'D-', color=colores[idx%4],
                 linewidth=2, label='Semiancho p95')
        ax2.set_xlabel(xlabel); ax2.set_ylabel("Semiancho p95 [mm]")
        ax2.set_title("Ventana de ajuste vs "+xlabel)
        ax2.legend(fontsize=8); ax2.grid()
        plt.tight_layout()
        plt.savefig(os.path.join(out_plots,
                    f"{nombre_base}_{fijo_label}{fijo:.0f}.png"), dpi=150)
        plt.close()
        print(f"Guardado: {nombre_base}_{fijo_label}{fijo:.0f}.png")

# mapas de color
mapa_color(D, ang, X_gs, D_vals, ang_vals, "gamma simple X combinado",  "mapa_comb_X_gs")
mapa_color(D, ang, X_g1, D_vals, ang_vals, "gamma1 core X combinado",   "mapa_comb_X_g1")
mapa_color(D, ang, X_g2, D_vals, ang_vals, "gamma2 cola X combinado",   "mapa_comb_X_g2")
mapa_color(D, ang, X_ge, D_vals, ang_vals, "gamma_eff X combinado",     "mapa_comb_X_ge")
mapa_color(D, ang, X_p95,D_vals, ang_vals, "Semiancho p95 X combinado", "mapa_comb_X_p95")
mapa_color(D, ang, Z_gs, D_vals, ang_vals, "gamma simple Z combinado",  "mapa_comb_Z_gs")
mapa_color(D, ang, Z_g1, D_vals, ang_vals, "gamma1 core Z combinado",   "mapa_comb_Z_g1")
mapa_color(D, ang, Z_g2, D_vals, ang_vals, "gamma2 cola Z combinado",   "mapa_comb_Z_g2")
mapa_color(D, ang, Z_ge, D_vals, ang_vals, "gamma_eff Z combinado",     "mapa_comb_Z_ge")
mapa_color(D, ang, Z_p95,D_vals, ang_vals, "Semiancho p95 Z combinado", "mapa_comb_Z_p95")

# evolución gamma_simple vs D fijando ang
plot_evolucion(D, ang, X_gs, X_es, X_p95, D_vals, ang_vals,
               "Comb X gamma_simple — vs D", "comb_X_gs_vsD",
               "D [cm]", "ang", ang_vals, ang, D)

# evolución gamma_simple vs ang fijando D
plot_evolucion(D, ang, X_gs, X_es, X_p95, D_vals, ang_vals,
               "Comb X gamma_simple — vs ang", "comb_X_gs_vsAng",
               "Ángulo [grados]", "D", D_vals, D, ang)

# evolución gamma2 vs D fijando ang
plot_evolucion(D, ang, X_g2, X_e2, X_p95, D_vals, ang_vals,
               "Comb X gamma2 — vs D", "comb_X_g2_vsD",
               "D [cm]", "ang", ang_vals, ang, D)

# evolución gamma2 vs ang fijando D
plot_evolucion(D, ang, X_g2, X_e2, X_p95, D_vals, ang_vals,
               "Comb X gamma2 — vs ang", "comb_X_g2_vsAng",
               "Ángulo [grados]", "D", D_vals, D, ang)

print("\nSC3 combinado completado.")