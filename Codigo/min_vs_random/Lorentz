import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit

sigma_hit = 0.085
archivo = r"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\muon_hits_complete.csv"
RUTA    = r"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\min_vs_random"

np.random.seed(42)

df     = pd.read_csv(archivo)
coords = df[['X','Y','Z']].to_numpy().reshape(-1,4,3)
coords_smeared = coords.copy()
valid = coords[:,:,0] != -99999
coords_smeared[:,:,0][valid] += np.random.normal(0, sigma_hit, np.sum(valid))
coords_smeared[:,:,2][valid] += np.random.normal(0, sigma_hit, np.sum(valid))
coords = coords_smeared

mask     = np.all(coords != -99999, axis=2)
hits     = mask.sum(axis=1)
eventos3 = np.where(hits == 3)[0]
eventos4 = np.where(hits == 4)[0]

def aplicar_percentil(data, p=95):
    low  = np.percentile(data, (100-p)/2)
    high = np.percentile(data, 100-(100-p)/2)
    return data[(data > low) & (data < high)]

# 3 hits
coords3 = coords[eventos3]; mask3 = mask[eventos3]
cv3 = np.array([ev[m] for ev,m in zip(coords3,mask3)])
cv3 = np.array([ev[np.argsort(ev[:,1])] for ev in cv3])
x3,y3 = cv3[:,:,0], cv3[:,:,1]
x_izq,x_mid,x_der = x3.T; y_izq,y_mid,y_der = y3.T
m_x = (x_izq-x_der)/(y_izq-y_der)
resX3_cut = aplicar_percentil(x_mid - m_x*y_mid - (x_izq-m_x*y_izq))

# 4 hits
combos = np.array([[0,1,2],[0,1,3],[0,2,3],[1,2,3]])
coords4 = coords[eventos4]
coords4 = np.array([ev[np.argsort(ev[:,1])] for ev in coords4])
coords4 = coords4[:,combos]
x4,y4  = coords4[:,:,:,0], coords4[:,:,:,1]
m_x    = (x4[:,:,0]-x4[:,:,2])/(y4[:,:,0]-y4[:,:,2])
resX_all = x4[:,:,1] - (m_x*y4[:,:,1] + (x4[:,:,0]-m_x*y4[:,:,0]))
resX_min_cut  = aplicar_percentil(resX_all[np.arange(len(resX_all)),
                                  np.argmin(np.abs(resX_all), axis=1)])
resX_rand_cut = aplicar_percentil(resX_all[np.arange(len(resX_all)),
                                  np.random.randint(0,4,size=len(resX_all))])

def lorentz(x, A, mu, gamma):
    return A / (1 + ((x-mu)/gamma)**2)

def double_lorentz(x, A1, gamma1, A2, gamma2, mu):
    return (A1/(1+((x-mu)/gamma1)**2) + A2/(1+((x-mu)/gamma2)**2))

def ajustar(data, doble=True):
    hist, bins = np.histogram(data, bins=60)
    centers = (bins[:-1]+bins[1:])/2
    g0 = np.std(data)*0.5

    try:
        pl, _ = curve_fit(lorentz, centers, hist,
                          p0=[max(hist),0,g0],
                          bounds=([0,-0.5,0],[np.inf,0.5,np.inf]), maxfev=10000)
        A_l,mu_l,gl = [float(p) for p in pl]
    except RuntimeError:
        return None

    res = {'hist':hist,'bins':bins,'centers':centers,
           'gl':gl,'mu_l':mu_l,'A_l':A_l,
           'params_d':None,'cov_d':None}

    if doble:
        try:
            pdl, cov_d = curve_fit(double_lorentz, centers, hist,
                                   p0=[max(hist),g0*0.3,max(hist)/5,g0*1.5,0],
                                   bounds=([0,0,0,0,-0.5],[np.inf,np.inf,np.inf,np.inf,0.5]),
                                   maxfev=10000)
            A1,g1,A2,g2,mu_dl = [float(p) for p in pdl]
            if g1>g2:
                A1,A2=A2,A1; g1,g2=g2,g1
                cov_d[[0,2]]=cov_d[[2,0]]; cov_d[:,[0,2]]=cov_d[:,[2,0]]
            if 0<g1<5 and 0<g2<5 and A1>0 and A2>0:
                res['params_d'] = (A1,g1,A2,g2,mu_dl)
                res['cov_d']    = cov_d
        except RuntimeError:
            pass
    return res

r3    = ajustar(resX3_cut,    doble=True)
rmin  = ajustar(resX_min_cut, doble=True)
rrand = ajustar(resX_rand_cut,doble=True)

casos = [
    (resX3_cut,    r3,    'green',  "3 hits"),
    (resX_min_cut, rmin,  'blue',   "4 hits mínimo"),
    (resX_rand_cut,rrand, 'orange', "4 hits aleatorio"),
]

# ── GRAFICA 1: comparativo superpuesto ───────────────────────────────────────
fig, ax = plt.subplots(figsize=(10,5))
for data, _, color, etiq in casos:
    ax.hist(data, bins=60, alpha=0.5, color=color, label=f"{etiq}  N={len(data)}")
ax.set_yscale('log')
ax.set_xlabel("Residual X [mm]"); ax.set_ylabel("Counts (log)")
ax.set_title("Comparativa residuales X — ajuste por Lorentzianas (percentil 95%)")
ax.legend(); ax.grid(which='both', linestyle='--', alpha=0.5)
fig.tight_layout()
fig.savefig(rf"{RUTA}\comparativo_lorentz.png", dpi=300)
plt.close(fig)
print("Guardado: comparativo_lorentz.png")

# ── GRAFICA 2: fits individuales en subplots ──────────────────────────────────
fig, axes = plt.subplots(1, 3, figsize=(15,5), sharey=False)
fig.suptitle("Ajuste por Lorentzianas — 3 hits, 4 hits mínimo, 4 hits aleatorio\n(percentil 95%)")

for ax, (data, r, color, etiq) in zip(axes, casos):
    if r is None: continue
    hist, bins, centers = r['hist'], r['bins'], r['centers']
    cp95 = (data.min(), data.max())
    margen = max(abs(cp95[0]), abs(cp95[1])) * 1.05
    x_fit = np.linspace(cp95[0], cp95[1], 300)
    w = bins[1]-bins[0]; mp = hist>0

    ax.bar(centers[mp], hist[mp], width=w, alpha=0.6, color=color,
           label=f"Datos  N={len(data)}")
    ax.set_yscale('log')
    ax.plot(x_fit, lorentz(x_fit,r['A_l'],r['mu_l'],r['gl']),
            color='black', linewidth=2, label=f"Lorentz  $\\gamma$={r['gl']:.4f}")
    if r['params_d'] is not None:
        A1,g1,A2,g2,mu_dl = r['params_d']
        ax.plot(x_fit, double_lorentz(x_fit,A1,g1,A2,g2,mu_dl),
                color='red', linewidth=2, linestyle='--', label="Doble Lorentz")
        ax.plot(x_fit, lorentz(x_fit,A1,mu_dl,g1), '--', color='blue',
                linewidth=1.2, label=f"Core $\\gamma_1$={g1:.4f}")
        ax.plot(x_fit, lorentz(x_fit,A2,mu_dl,g2), '--', color='orange',
                linewidth=1.2, label=f"Cola $\\gamma_2$={g2:.4f}")
        ax.text(0.97, 0.97, f"$A_1/A_2$ = {A1/A2:.2f}",
                transform=ax.transAxes, fontsize=8, va='top', ha='right',
                bbox=dict(boxstyle='round', fc='white', alpha=0.8))

    ax.axvline(cp95[0], color='magenta', linewidth=1.5,
               label=f"p95: [{cp95[0]:.3f},{cp95[1]:.3f}]")
    ax.axvline(cp95[1], color='magenta', linewidth=1.5)
    ax.set_xlim(-margen, margen)
    ax.set_title(etiq); ax.set_xlabel("Residual X [mm]")
    ax.legend(fontsize=6.5); ax.grid(which='both', linestyle='--', alpha=0.5)

axes[0].set_ylabel("Counts (log)")
fig.tight_layout()
fig.savefig(rf"{RUTA}\fits_lorentz.png", dpi=300)
plt.close(fig)
print("Guardado: fits_lorentz.png")

# ── TXT RESUMEN ───────────────────────────────────────────────────────────────
with open(rf"{RUTA}\resumen_lorentz.txt", "w", encoding="utf-8") as f:
    f.write("Resumen ajuste Lorentziano — seleccion minimo vs aleatoria vs 3 hits\n")
    f.write(f"sigma_hit = {sigma_hit:.3f} mm, percentil 95%\n")
    f.write("="*65 + "\n\n")
    for data, r, _, etiq in casos:
        if r is None: continue
        f.write(f"--- {etiq} ---\n")
        f.write(f"  p95:               [{data.min():.4f}, {data.max():.4f}] mm\n")
        f.write(f"  Lorentz simple:\n")
        f.write(f"    gamma            = {r['gl']:.4f} mm\n")
        if r['params_d'] is not None:
            A1,g1,A2,g2,mu_dl = r['params_d']
            cov = r['cov_d']
            # correlacion entre gamma1 (indice 1) y gamma2 (indice 3) en la cov
            corr_g1g2 = cov[1,3] / np.sqrt(cov[1,1]*cov[3,3]) if cov[1,1]>0 and cov[3,3]>0 else np.nan
            f.write(f"  Doble Lorentz:\n")
            f.write(f"    gamma1 (core)    = {g1:.4f} mm\n")
            f.write(f"    gamma2 (cola)    = {g2:.4f} mm\n")
            f.write(f"    A1/A2            = {A1/A2:.3f}\n")
            f.write(f"    corr(g1,g2)      = {corr_g1g2:.4f}\n")
        else:
            f.write(f"  Doble Lorentz:     no aplicado\n")
        f.write("\n")
print("Guardado: resumen_lorentz.txt")