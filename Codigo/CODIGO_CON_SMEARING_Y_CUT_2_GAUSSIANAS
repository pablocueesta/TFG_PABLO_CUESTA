# -------------------
# FUNCIONES DE FIT
# -------------------
def gauss(x, A, mu, sigma):
    return A * np.exp(-(x - mu)**2 / (2 * sigma**2))

def double_gauss(x, A1, sigma1, A2, sigma2, mu):
    return (A1 * np.exp(-(x - mu)**2 / (2 * sigma1**2)) +
            A2 * np.exp(-(x - mu)**2 / (2 * sigma2**2)))

# -------------------
# FUNCIÓN PARA HACER TODO EL ANÁLISIS
# -------------------
def analizar_residuals(data, titulo):

    # Histograma
    hist, bins = np.histogram(data, bins=60)
    centers = (bins[:-1] + bins[1:]) / 2

    # -------------------
    # FIT GAUSSIANO SIMPLE
    # -------------------
    p0 = [max(hist), 0, 0.1]

    params_gauss, _ = curve_fit(gauss, centers, hist, p0=p0)
    A_g, mu_g, sigma_g = params_gauss

    # -------------------
    # FIT DOBLE GAUSSIANA
    # -------------------
    p0_double = [max(hist), 0.1, max(hist)/5, 0.3, 0]

    params_double, _ = curve_fit(double_gauss, centers, hist, p0=p0_double)
    A1, sigma1, A2, sigma2, mu_d = params_double

    # corregir intercambio
    if sigma1 > sigma2:
        A1, A2         = A2, A1
        sigma1, sigma2 = sigma2, sigma1

    # -------------------
    # PLOT
    # -------------------
    plt.figure()
    plt.hist(data, bins=60, alpha=0.6, label="Datos (cut)")
    #plt.xlim(-50, 50)
    x_fit = np.linspace(min(centers), max(centers), 300)

    plt.plot(x_fit, gauss(x_fit, *params_gauss),
             label=rf"Gauss: $\sigma_s$={sigma_g:.3f} mm", linewidth=2)

    plt.plot(x_fit, double_gauss(x_fit, *params_double),
             label=f"Doble Gauss:\n" + rf"$\sigma_1$={sigma1:.3f}, $\sigma_2$={sigma2:.3f} mm", linewidth=2)

    plt.title(titulo + " - Cut 0.35 mm")
    plt.xlabel("Residual (mm)", fontsize=10)
    plt.axvline(-0.35, color='magenta', linestyle='-', linewidth=1.5,
                   label=f"Cut 0.35 mm")
    plt.axvline(0.35, color='magenta', linestyle='-', linewidth=1.5)
    plt.xlim(-0.45, 0.45)
    plt.ylabel("Cuentas", fontsize=10)
    plt.legend()
    plt.grid()
    
    nombre_archivo = titulo.replace(" ", "_").replace("(", "").replace(")", "")
    ruta = rf"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\{nombre_archivo}.png"

    plt.savefig(ruta)
    
    #plt.savefig(r"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\Plots\doble_gaussiana.png")
    plt.show()

    # ------------------- 
    # PRINT RESULTADOS
    # -------------------
    f_info.write(f"\n--- {titulo} ---\n")
    f_info.write(f"Gauss simple: mu = {mu_g:.4f}, sigma = {sigma_g:.4f}\n")
    f_info.write(f"Doble Gauss:\n")
    f_info.write(f"   mu = {mu_d:.4f}\n")
    f_info.write(f"   sigma1 (core) = {sigma1:.4f}\n")
    f_info.write(f"   sigma2 (cola) = {sigma2:.4f}\n")
    
    print(f"\n--- {titulo} ---")
    print(f"Gauss simple: mu = {mu_g:.4f}, sigma = {sigma_g:.4f}")
    print(f"Doble Gauss:")
    print(f"   mu = {mu_d:.4f}")
    print(f"   sigma1 (core) = {sigma1:.4f}")
    print(f"   sigma2 (cola) = {sigma2:.4f}")

