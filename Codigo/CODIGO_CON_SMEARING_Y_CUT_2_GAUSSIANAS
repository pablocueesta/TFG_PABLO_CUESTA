df = pd.read_csv(archivo)
coords = df[['X','Y','Z']].to_numpy().reshape(-1,4,3) #eventos,detectores,coordenadas

coords_smeared = coords.copy()
valid = coords[:,:,0] != -99999
coords_smeared[:,:,0][valid] += np.random.normal(0, sigma_hit, np.sum(valid))
coords_smeared[:,:,2][valid] += np.random.normal(0, sigma_hit, np.sum(valid))

coords = coords_smeared

mask = np.all(coords != -99999, axis=2) #axis=0(eventos), axis=1(detectores), axis=2(coordenadas)
hits = mask.sum(axis=1)

# separar eventos
eventos3 = np.where(hits == 3)[0]
eventos4 = np.where(hits == 4)[0]

# -------------------
# 3 HITS
# -------------------
coords3 = coords[eventos3]
mask3 = mask[eventos3]

coords_validos = np.array([ev[m] for ev,m in zip(coords3,mask3)]) #m filtra los detectores válidos
coords_validos = np.array([ev[np.argsort(ev[:,1])] for ev in coords_validos]) #ordenar por coordenada Y para identificar izq, mid, der

x3 = coords_validos[:,:,0]
y3 = coords_validos[:,:,1]
z3 = coords_validos[:,:,2]

x_izq, x_mid, x_der = x3.T #transpuesta para separar cada coordenada por detector (izq, mid, der)
y_izq, y_mid, y_der = y3.T
z_izq, z_mid, z_der = z3.T

m_x = (x_izq - x_der)/(y_izq - y_der)
x_teo = m_x*y_mid + (x_izq - m_x*y_izq)
resX3 = (x_mid - x_teo)
resX3_cut = resX3[np.abs(resX3) < cut]

m_z = (z_izq - z_der)/(y_izq - y_der)
z_teo = m_z*y_mid + (z_izq - m_z*y_izq)
resZ3 = (z_mid - z_teo)
resZ3_cut = resZ3[np.abs(resZ3) < cut]

# -------------------
# 4 HITS
# -------------------
combos = np.array([[0,1,2],[0,1,3],[0,2,3],[1,2,3]])
coords4 = coords[eventos4]
coords4 = np.array([ev[np.argsort(ev[:,1])] for ev in coords4])
coords4 = coords4[:,combos]
x4,y4,z4 = coords4[:,:,:,0], coords4[:,:,:,1], coords4[:,:,:,2]

m_x = (x4[:,:,0]-x4[:,:,2])/(y4[:,:,0]-y4[:,:,2])
x_teo = m_x*y4[:,:,1] + (x4[:,:,0]-m_x*y4[:,:,0])
resX_all = x4[:,:,1] - x_teo
idx_min_X = np.argmin(np.abs(resX_all), axis=1)
resX4 = resX_all[np.arange(len(resX_all)), idx_min_X]
resX4_cut = resX4[np.abs(resX4) < cut]

m_z = (z4[:,:,0]-z4[:,:,2])/(y4[:,:,0]-y4[:,:,2])
z_teo = m_z*y4[:,:,1] + (z4[:,:,0]-m_z*y4[:,:,0])
resZ_all = z4[:,:,1] - z_teo
idx_min_Z = np.argmin(np.abs(resZ_all), axis=1)
resZ4 = resZ_all[np.arange(len(resZ_all)), idx_min_Z]
resZ4_cut = resZ4[np.abs(resZ4) < cut]

