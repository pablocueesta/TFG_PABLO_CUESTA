import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit
import os

BASE    = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                        '..', '..'))
carpeta = os.path.join(BASE, "Datos", "Estudio", "D_Ang_Sigma_Combinado_Lorentz")
out_dir = os.path.join(carpeta, "modelo_multivariable")
os.makedirs(out_dir, exist_ok=True)

data = np.loadtxt(os.path.join(carpeta, "todos_D_ang_sigma.txt"), skiprows=1)

# columnas:
# [0] sigma  [1] D  [2] ang
# [3] X_gamma_s [4] X_err_s [5] X_gamma1 [6] X_err1 [7] X_gamma2 [8] X_err2
# [9] X_gamma_eff [10] X_p95_lo [11] X_p95_hi
# [12] Z_gamma_s [13] Z_err_s [14] Z_gamma1 [15] Z_err1 [16] Z_gamma2 [17] Z_err2
# [18] Z_gamma_eff [19] Z_p95_lo [20] Z_p95_hi

sigma = data[:,0]; D = data[:,1]; ang = data[:,2]
X_g1  = data[:,5];  X_e1 = data[:,6]
X_g2  = data[:,7];  X_e2 = data[:,8]
Z_g1  = data[:,14]; Z_e1 = data[:,15]
Z_g2  = data[:,16]; Z_e2 = data[:,17]

f_out = open(os.path.join(out_dir, "modelo_multivariable.txt"), "w", encoding="utf-8")
f_out.write("Modelo lineal multivariable: gamma = a0 + a1*sigma + a2*D + a3*theta + a12*sigma*D + a13*sigma*theta + a23*D*theta\n")
f_out.write("Dos tramos de D: D<=20cm y D>=20cm\n")
f_out.write("="*80 + "\n\n")

def preparar_datos(gamma, err, sigma, D, ang,
                   excluir_60=True, D_max=None, D_min=None):
    """
    Filtra datos validos y devuelve arrays limpios.
    excluir_60: si True excluye theta=60 completamente
                si False solo excluye NaN
    D_max, D_min: limites de D para el tramo
    """
    mask = (np.isfinite(gamma) & np.isfinite(err) &
            (err > 0) & (gamma > 0) & (gamma < 5))
    if excluir_60:
        mask = mask & (ang < 60)
    if D_max is not None:
        mask = mask & (D <= D_max)
    if D_min is not None:
        mask = mask & (D >= D_min)
    return sigma[mask], D[mask], ang[mask], gamma[mask], err[mask]

def modelo(X, a0, a1, a2, a3, a12, a13, a23):
    """
    Modelo lineal multivariable con terminos de interaccion.
    X = (sigma, D, theta)
    """
    s, d, t = X
    return a0 + a1*s + a2*d + a3*t + a12*s*d + a13*s*t + a23*d*t

def ajustar_modelo(s, d, t, gamma, err, nombre, f_out):
    """
    Ajusta el modelo lineal multivariable por minimos cuadrados ponderados.
    Devuelve los coeficientes y su incertidumbre.
    """
    if len(gamma) < 7:
        f_out.write(f"  {nombre}: insuficientes puntos ({len(gamma)})\n\n")
        return None, None

    try:
        popt, pcov = curve_fit(modelo, (s, d, t), gamma,
                               sigma=err, absolute_sigma=True,
                               p0=[0.01, 0.3, 0.001, 0.0001, 0.001, 0.0001, 0.00001],
                               maxfev=50000)
        perr = np.sqrt(np.diag(pcov))
    except RuntimeError:
        f_out.write(f"  {nombre}: ajuste no convergido\n\n")
        return None, None

    a0,a1,a2,a3,a12,a13,a23 = popt
    e0,e1,e2,e3,e12,e13,e23 = perr

    # residuos y chi2 reducido
    gamma_pred = modelo((s,d,t), *popt)
    residuos   = (gamma - gamma_pred) / err
    chi2_red   = np.sum(residuos**2) / (len(gamma) - 7)

    f_out.write(f"  {nombre}  (N={len(gamma)}):\n")
    f_out.write(f"    a0  (cte)         = {a0:.6f} +- {e0:.6f} mm\n")
    f_out.write(f"    a1  (sigma)        = {a1:.4f} +- {e1:.4f}  [adim]\n")
    f_out.write(f"    a2  (D)            = {a2:.5f} +- {e2:.5f}  [mm/cm]\n")
    f_out.write(f"    a3  (theta)        = {a3:.6f} +- {e3:.6f}  [mm/grado]\n")
    f_out.write(f"    a12 (sigma*D)      = {a12:.5f} +- {e12:.5f}  [mm/(mm*cm)]\n")
    f_out.write(f"    a13 (sigma*theta)  = {a13:.6f} +- {e13:.6f}  [mm/(mm*grado)]\n")
    f_out.write(f"    a23 (D*theta)      = {a23:.7f} +- {e23:.7f}  [mm/(cm*grado)]\n")
    f_out.write(f"    chi2/dof           = {chi2_red:.4f}\n\n")

    # significancia de cada termino (ratio coef/error)
    f_out.write(f"    Significancia (|coef/err|):\n")
    nombres_coef = ['a0','a1','a2','a3','a12','a13','a23']
    for nc, c, e in zip(nombres_coef, popt, perr):
        sig = abs(c/e) if e > 0 else np.inf
        f_out.write(f"      {nc}: {sig:.1f}σ {'<-- DESPRECIABLE' if sig < 2 else ''}\n")
    f_out.write("\n")

    return popt, pcov

def plot_residuos(s, d, t, gamma, err, popt, nombre, coord):
    """
    Plot de residuos normalizados y prediccion vs medida.
    """
    gamma_pred = modelo((s,d,t), *popt)
    residuos   = (gamma - gamma_pred) / err

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12,5))
    fig.suptitle(f"Modelo multivariable — {nombre} ({coord})")

    # prediccion vs medida
    lim = max(gamma.max(), gamma_pred.max()) * 1.05
    ax1.scatter(gamma, gamma_pred, c=d, cmap='viridis', s=40, alpha=0.8)
    ax1.plot([0,lim],[0,lim],'r--',linewidth=1.5,label='y=x')
    ax1.set_xlabel("γ medido [mm]"); ax1.set_ylabel("γ predicho [mm]")
    ax1.set_title("Prediccion vs medida")
    ax1.legend(); ax1.grid()

    # residuos normalizados
    ax2.scatter(gamma_pred, residuos, c=s, cmap='plasma', s=40, alpha=0.8)
    ax2.axhline(0, color='red', linestyle='--', linewidth=1.5)
    ax2.axhline( 2, color='gray', linestyle=':', linewidth=1)
    ax2.axhline(-2, color='gray', linestyle=':', linewidth=1)
    ax2.set_xlabel("γ predicho [mm]"); ax2.set_ylabel("Residuo normalizado")
    ax2.set_title("Residuos normalizados")
    ax2.grid()

    fig.tight_layout()
    nombre_arch = nombre.replace(" ","_").replace("<=","le").replace(">=","ge")
    fig.savefig(os.path.join(out_dir, f"residuos_{coord}_{nombre_arch}.png"), dpi=150)
    plt.close(fig)

def plot_prediccion_vs_sigma(s, d, t, gamma, err, popt, nombre, coord):
    """
    Plot de gamma vs sigma para cada D, comparando medida y prediccion.
    """
    colores_D = {7.0:'blue', 13.0:'red', 20.0:'green', 30.0:'orange'}
    D_vals_plot = np.unique(d)

    fig, ax = plt.subplots(figsize=(9,6))
    ax.set_title(f"Medida vs modelo — {nombre} ({coord})")

    for dv in D_vals_plot:
        mask = d == dv
        s_m, g_m, e_m = s[mask], gamma[mask], err[mask]
        t_m = t[mask]
        orden = np.argsort(s_m)
        s_m,g_m,e_m,t_m = s_m[orden],g_m[orden],e_m[orden],t_m[orden]

        color = colores_D.get(dv, 'black')
        ax.errorbar(s_m, g_m, yerr=e_m, fmt='o', color=color,
                    capsize=3, label=f"D={dv:.0f}cm (medida)")

        # prediccion con theta=0 (valor tipico)
        s_pred = np.linspace(s_m.min(), s_m.max(), 100)
        g_pred = modelo((s_pred, np.full_like(s_pred,dv), np.zeros_like(s_pred)), *popt)
        ax.plot(s_pred, g_pred, '--', color=color, linewidth=1.5)

    ax.set_xlabel("σ_hit [mm]"); ax.set_ylabel("γ [mm]")
    ax.legend(fontsize=8); ax.grid(linestyle='--', alpha=0.5)
    fig.tight_layout()
    nombre_arch = nombre.replace(" ","_").replace("<=","le").replace(">=","ge")
    fig.savefig(os.path.join(out_dir, f"pred_vs_sigma_{coord}_{nombre_arch}.png"), dpi=150)
    plt.close(fig)

# ── EJECUTAR AJUSTES ──────────────────────────────────────────────────────────

for coord, g1, e1, g2, e2 in [("X", X_g1, X_e1, X_g2, X_e2),
                                ("Z", Z_g1, Z_e1, Z_g2, Z_e2)]:
    f_out.write(f"\n{'='*80}\n")
    f_out.write(f"COORDENADA {coord}\n")
    f_out.write(f"{'='*80}\n\n")

    for gamma_arr, err_arr, param in [(g1, e1, "gamma1"), (g2, e2, "gamma2")]:

        f_out.write(f"--- {param} ---\n\n")

        # ── TRAMO 1: D <= 20cm, theta < 60 ───────────────────────────────────
        s,d,t,g,e = preparar_datos(gamma_arr, err_arr, sigma, D, ang,
                                   excluir_60=True, D_max=20.0)
        nombre1 = f"{param} D<=20cm excl60"
        f_out.write(f"  Tramo D<=20cm (excluye theta=60°):\n")
        popt1, pcov1 = ajustar_modelo(s,d,t,g,e, nombre1, f_out)
        if popt1 is not None:
            plot_residuos(s,d,t,g,e,popt1,nombre1,coord)
            plot_prediccion_vs_sigma(s,d,t,g,e,popt1,nombre1,coord)

        # ── TRAMO 1 alternativo: solo excluye NaN ────────────────────────────
        s,d,t,g,e = preparar_datos(gamma_arr, err_arr, sigma, D, ang,
                                   excluir_60=False, D_max=20.0)
        nombre1b = f"{param} D<=20cm soloNaN"
        f_out.write(f"  Tramo D<=20cm (excluye solo NaN, incluye theta=60°):\n")
        ajustar_modelo(s,d,t,g,e, nombre1b, f_out)

        # ── TRAMO 2: D >= 20cm, theta < 60 ───────────────────────────────────
        s,d,t,g,e = preparar_datos(gamma_arr, err_arr, sigma, D, ang,
                                   excluir_60=True, D_min=20.0)
        nombre2 = f"{param} D>=20cm excl60"
        f_out.write(f"  Tramo D>=20cm (excluye theta=60°):\n")
        popt2, pcov2 = ajustar_modelo(s,d,t,g,e, nombre2, f_out)
        if popt2 is not None:
            plot_residuos(s,d,t,g,e,popt2,nombre2,coord)
            plot_prediccion_vs_sigma(s,d,t,g,e,popt2,nombre2,coord)

        # ── TRAMO 2 alternativo: solo excluye NaN ────────────────────────────
        s,d,t,g,e = preparar_datos(gamma_arr, err_arr, sigma, D, ang,
                                   excluir_60=False, D_min=20.0)
        nombre2b = f"{param} D>=20cm soloNaN"
        f_out.write(f"  Tramo D>=20cm (excluye solo NaN, incluye theta=60°):\n")
        ajustar_modelo(s,d,t,g,e, nombre2b, f_out)

        f_out.write("\n")

f_out.close()
print(f"\nResultados en: {out_dir}")
print("Archivos generados: modelo_multivariable.txt + plots de residuos y prediccion")