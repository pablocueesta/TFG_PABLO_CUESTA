import numpy as np
import matplotlib.pyplot as plt
from matplotlib.colors import LinearSegmentedColormap, TwoSlopeNorm
import os

BASE    = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                        '..', '..'))
carpeta   = os.path.join(BASE, "Datos", "Estudio", "D_Ang_Sigma_Combinado_Lorentz")
out_mapas = os.path.join(carpeta, "mapas_color")
out_evol  = os.path.join(carpeta, "plots_evolucion")
os.makedirs(out_mapas, exist_ok=True)
os.makedirs(out_evol,  exist_ok=True)

data = np.loadtxt(os.path.join(carpeta, "todos_D_ang_sigma.txt"), skiprows=1)

# columnas:
# [0] sigma  [1] D  [2] ang
# [3] X_gamma_s [4] X_err_s [5] X_gamma1 [6] X_err1 [7] X_gamma2 [8] X_err2
# [9] X_gamma_eff [10] X_p95_lo [11] X_p95_hi
# [12] Z_gamma_s [13] Z_err_s [14] Z_gamma1 [15] Z_err1 [16] Z_gamma2 [17] Z_err2
# [18] Z_gamma_eff [19] Z_p95_lo [20] Z_p95_hi

D_vals     = np.array([7.0, 13.0, 20.0, 30.0])
ang_vals   = np.array([0,   20,   40,   60])
sigma_vals = np.array([0.050, 0.085, 0.130, 0.200])

S_NOM, D_NOM, A_NOM = 0.085, 13.0, 0

sigma = data[:,0]; D = data[:,1]; ang = data[:,2]
X_gs  = data[:,3];  X_es = data[:,4]
X_g1  = data[:,5];  X_e1 = data[:,6]
X_g2  = data[:,7];  X_e2 = data[:,8];  X_ge  = data[:,9]
X_p95 = (data[:,11]-data[:,10])/2
Z_gs  = data[:,12]; Z_es = data[:,13]
Z_g1  = data[:,14]; Z_e1 = data[:,15]
Z_g2  = data[:,16]; Z_e2 = data[:,17]; Z_ge  = data[:,18]
Z_p95 = (data[:,20]-data[:,19])/2

CMAP = LinearSegmentedColormap.from_list('br_purple',
    ['#1a53ff', '#7a00cc', '#cc0000'])

def limpiar(x, y, e=None):
    if e is not None:
        mask = np.isfinite(x)&np.isfinite(y)&np.isfinite(e)&(e>0)&(y>0)&(y<5)
        return x[mask],y[mask],e[mask]
    mask = np.isfinite(x)&np.isfinite(y)&(y>0)
    return x[mask],y[mask]

def get_nominal(valores):
    mask = (sigma==S_NOM)&(D==D_NOM)&(ang==A_NOM)
    if mask.sum()==1 and np.isfinite(valores[mask][0]) and valores[mask][0]>0:
        return valores[mask][0]
    return np.nan

def matriz_mapas(valores, titulo_base, nombre_base):
    fig, axes = plt.subplots(1, 4, figsize=(20,5))
    fig.suptitle(f"{titulo_base} — Mapa D×θ para cada σ_hit\n"
                 #f"(cada mapa normalizado a su propio nominal: D={D_NOM:.0f}cm, θ=0°)"
                )

    for idx, s in enumerate(sigma_vals):
        ax = axes[idx]
        ax.set_facecolor('#f5f5f5')

        # nominal propio de este sigma_hit
        mask_nom = (sigma==s)&(D==D_NOM)&(ang==A_NOM)
        if mask_nom.sum()==1 and np.isfinite(valores[mask_nom][0]) and valores[mask_nom][0]>0:
            v_nom_s = valores[mask_nom][0]
        else:
            print(f"  AVISO: sin nominal para sigma={s} en {titulo_base}"); continue
        ax.set_title(f"σ_hit={s:.3f} mm\n(nom={v_nom_s:.4f} mm)", fontsize=9)

        xs,ys,vs,ns = [],[],[],[]
        for d in D_vals:
            for a in ang_vals:
                mask = (sigma==s)&(D==d)&(ang==a)
                if mask.sum()==1:
                    v = valores[mask][0]
                    if np.isfinite(v) and v>0:
                        xs.append(d); ys.append(a)
                        vs.append(v); ns.append(v/v_nom_s)

        if len(xs)==0: continue
        xs=np.array(xs); ys=np.array(ys); vs=np.array(vs); ns=np.array(ns)
        desv=max(abs(ns.max()-1),abs(ns.min()-1))
        if desv<0.01: desv=0.01
        norm=TwoSlopeNorm(vcenter=1.0, vmin=1-desv*1.1, vmax=1+desv*1.1)

        sc=ax.scatter(xs,ys,c=ns,cmap=CMAP,norm=norm,
                      s=800,zorder=3,edgecolors='gray',linewidths=0.5)
        fig.colorbar(sc,ax=ax,label="Valor nominal normalizado")

        for xi,yi,vi,ni in zip(xs,ys,vs,ns):
            pct=(ni-1)*100; sign='+' if pct>=0 else ''
            ax.text(xi,yi+1.5,f"{vi:.3f}",ha='center',va='center',
                    fontsize=6.5,fontweight='bold',zorder=4)
            ax.text(xi,yi-1.5,f"({sign}{pct:.1f}%)",ha='center',va='center',
                    fontsize=5.5,color='#333333',zorder=4)

        ax.set_xticks(D_vals); ax.set_xticklabels([f"{d:.0f}" for d in D_vals])
        ax.set_yticks(ang_vals); ax.set_yticklabels([f"{a:.0f}" for a in ang_vals])
        ax.set_xlim(D_vals[0]-4,D_vals[-1]+4)
        ax.set_ylim(ang_vals[0]-8,ang_vals[-1]+8)
        ax.set_xlabel("D [cm]"); ax.set_ylabel("θ (°)")

    fig.tight_layout()
    fig.savefig(os.path.join(out_mapas,f"{nombre_base}_matriz.png"),dpi=200)
    plt.close(fig)
    print(f"Guardado: {nombre_base}_matriz.png")

def evolucion_vs_sigma(valores, err, titulo_base, nombre_base, label_y):
    colores_D   = {7.0:'blue',13.0:'red',20.0:'green',30.0:'orange'}
    markers_ang = {0:'o',20:'s',40:'^',60:'D'}

    fig,ax = plt.subplots(figsize=(10,6))
    ax.set_title(f"{titulo_base} — evolución vs σ_hit")

    for d in D_vals:
        for a in ang_vals:
            mask_da=(D==d)&(ang==a)
            xc,yc,ec=limpiar(sigma[mask_da],valores[mask_da],err[mask_da])
            if len(xc)<2: continue
            orden=np.argsort(xc); xc,yc,ec=xc[orden],yc[orden],ec[orden]
            ax.errorbar(xc,yc,yerr=ec,
                        fmt=f"{markers_ang[a]}-",
                        color=colores_D[d],capsize=3,linewidth=1.2,
                        label=f"D={d:.0f}cm θ={a}°" if a==0 else None,
                        alpha=0.8)

    from matplotlib.lines import Line2D
    leg_D  =[Line2D([0],[0],color=c,linewidth=2,label=f"D={d:.0f}cm")
             for d,c in colores_D.items()]
    leg_ang=[Line2D([0],[0],marker=m,color='gray',linestyle='None',
                    markersize=6,label=f"θ={a}°")
             for a,m in markers_ang.items()]
    ax.legend(handles=leg_D+leg_ang,fontsize=7,ncol=2)
    ax.set_xlabel("σ_hit [mm]"); ax.set_ylabel(label_y)
    ax.grid(linestyle='--',alpha=0.5)
    fig.tight_layout()
    fig.savefig(os.path.join(out_evol,f"{nombre_base}_vs_sigma.png"),dpi=200)
    plt.close(fig)
    print(f"Guardado: {nombre_base}_vs_sigma.png")

def evolucion_vs_D(valores, err, titulo_base, nombre_base, label_y):
    colores_s={0.050:'blue',0.085:'red',0.130:'green',0.200:'orange'}
    fig,ax=plt.subplots(figsize=(8,5))
    ax.set_title(f"{titulo_base} — evolución vs D (θ=0°)")
    for s in sigma_vals:
        mask_s=(sigma==s)&(ang==0)
        xc,yc,ec=limpiar(D[mask_s],valores[mask_s],err[mask_s])
        if len(xc)<2: continue
        orden=np.argsort(xc); xc,yc,ec=xc[orden],yc[orden],ec[orden]
        ax.errorbar(xc,yc,yerr=ec,fmt='o-',color=colores_s[s],
                    capsize=3,label=f"σ_hit={s:.3f}mm")
    ax.set_xlabel("D [cm]"); ax.set_ylabel(label_y)
    ax.legend(fontsize=8); ax.grid(linestyle='--',alpha=0.5)
    fig.tight_layout()
    fig.savefig(os.path.join(out_evol,f"{nombre_base}_vs_D.png"),dpi=200)
    plt.close(fig)
    print(f"Guardado: {nombre_base}_vs_D.png")

# matriz de mapas D×theta para cada sigma
matriz_mapas(X_g1, "Mapas gamma1 (mm) eje X", "comb_X_g1")
matriz_mapas(X_g2, "Mapas gamma2 (mm) eje X", "comb_X_g2")
matriz_mapas(Z_g1, "Mapas gamma1 (mm) eje Z", "comb_Z_g1")
matriz_mapas(Z_g2, "Mapas gamma2 (mm) eje Z", "comb_Z_g2")

# evolución vs sigma_hit
evolucion_vs_sigma(X_g1, X_e1, "Evolución gamma1 (mm) eje X", "comb_X_g1", "γ₁ [mm]")
evolucion_vs_sigma(X_g2, X_e2, "Evolución gamma2 (mm) eje X", "comb_X_g2", "γ₂ [mm]")
evolucion_vs_sigma(Z_g1, Z_e1, "Evolución gamma1 (mm) eje Z", "comb_Z_g1", "γ₁ [mm]")
evolucion_vs_sigma(Z_g2, Z_e2, "Evolución gamma2 (mm) eje Z", "comb_Z_g2", "γ₂ [mm]")

# evolución vs D para cada sigma (theta=0)
evolucion_vs_D(X_g1, X_e1, "Evolución gamma1 (mm) eje X", "comb_X_g1", "γ₁ [mm]")
evolucion_vs_D(X_g2, X_e2, "Evolución gamma2 (mm) eje X", "comb_X_g2", "γ₂ [mm]")
evolucion_vs_D(Z_g1, Z_e1, "Evolución gamma1 (mm) eje Z", "comb_Z_g1", "γ₁ [mm]")
evolucion_vs_D(Z_g2, Z_e2, "Evolución gamma2 (mm) eje Z", "comb_Z_g2", "γ₂ [mm]")

print("\nSC3 combinado completado.")