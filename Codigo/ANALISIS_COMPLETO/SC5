import numpy as np
import matplotlib.pyplot as plt
import os

BASE    = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                        '..', '..'))
out_dir = os.path.join(BASE, "Datos", "Estudio", "D_Ang_Sigma_Lorentz",
                       "modelo_multivariable_separado")
os.makedirs(out_dir, exist_ok=True)

# Rellenar con los valores del modelo_multivariable_separado.txt tras ejecutar SC4
# Orden por caso: a0, a1, a2, a3, a12, a13, a23
coefs = {
    "X 3h":  [(0.004272,0.003288),(1.2459,0.0363),(0.00037,0.00017),(0.000227,0.000098),(0.00019,0.00177),(-0.001366,0.000921),(-0.0000019,0.0000041)],
    "X g1":  [(0.001731,0.000993),(0.0982,0.0094),(-0.00002,0.00004),(-0.000092,0.000027),(-0.00009,0.00038),(0.000331,0.000178),(0.0000024,0.0000010)],
    "X g2":  [(0.004005,0.000704),(0.2106,0.0070),(0.00003,0.00005),(-0.000019,0.000022),(0.01586,0.00054),(0.000416,0.000208),(-0.0000007,0.0000013)],
    "Z 3h":  [(0.011047,0.003305),(1.2404,0.0369),(-0.00034,0.00017),(0.000027,0.000097),(0.00316,0.00179),(-0.002491,0.000913),(0.0000180,0.0000042)],
    "Z g1":  [(-0.000065,0.001005),(0.1083,0.0098),(0.00002,0.00004),(0.000048,0.000031),(-0.00017,0.00039),(-0.000142,0.000196),(-0.0000015,0.0000011)],
    "Z g2":  [(0.003073,0.000624),(0.2195,0.0064),(0.00007,0.00005),(0.000035,0.000023),(0.01531,0.00054),(0.000175,0.000201),(-0.0000031,0.0000013)],
}

etiquetas_casos = list(coefs.keys())
nombres_coef    = [r"$a_0$", r"$a_1$", r"$a_2$", r"$a_3$",
                   r"$a_{12}$", r"$a_{13}$", r"$a_{23}$"]
escalas = [1000, 1, 1000, 10000, 100, 10000, 1e6]
unidades= ["(mm·10³)", "(adim)", "(mm/cm·10³)", "(mm/°·10⁴)",
           "(10²·mm/(mm·cm))", "(10⁴·mm/(mm·°))", "(10⁶·mm/(cm·°))"]

colores_caso = {
    "X 3h": '#1f77b4',
    "X g1": '#d62728',
    "X g2": '#ff7f0e',
    "Z 3h": '#2ca02c',
    "Z g1": '#9467bd',
    "Z g2": '#8c564b',
}

from matplotlib.patches import Patch

n_casos = len(etiquetas_casos)
x_pos   = np.arange(n_casos)

def hacer_figura(indices, titulo, nombre_archivo):
    n = len(indices)
    fig, axes = plt.subplots(1, n, figsize=(n*3.2, 6))
    if n == 1: axes = [axes]
    fig.suptitle(titulo, fontsize=10)

    for ax, ci in zip(axes, indices):
        nombre = nombres_coef[ci]
        escala = escalas[ci]
        unidad = unidades[ci]
        for ki, caso in enumerate(etiquetas_casos):
            val = coefs[caso][ci][0] * escala
            err = coefs[caso][ci][1] * escala
            color = colores_caso[caso]
            ax.bar(ki, val, color=color, alpha=0.85, width=0.7)
            ax.errorbar(ki, val, yerr=2*err, fmt='none', color='black',
                        capsize=3, linewidth=1.2)
        ax.axhline(0, color='black', linewidth=0.8)
        ax.set_title(f"{nombre}\n{unidad}", fontsize=8)
        ax.set_xticks(x_pos)
        ax.set_xticklabels(etiquetas_casos, rotation=45, ha='right', fontsize=6.5)
        ax.grid(axis='y', linestyle='--', alpha=0.4)
        ax.tick_params(axis='y', labelsize=7)

    handles = [Patch(color=colores_caso[c], alpha=0.85, label=c) for c in etiquetas_casos]
    fig.legend(handles=handles, loc='lower center', ncol=3, fontsize=7.5,
               bbox_to_anchor=(0.5, -0.02))
    fig.tight_layout(rect=[0, 0.10, 1, 1])
    ruta = os.path.join(out_dir, nombre_archivo)
    fig.savefig(ruta, dpi=200, bbox_inches='tight')
    plt.close(fig)
    print(f"Guardado: {ruta}")

hacer_figura([0,1,2,3],
             r"Efectos principales separado: $a_0$, $a_1$ ($\sigma_{hit}$), $a_2$ ($D$), $a_3$ ($\theta$)",
             "coef_sep_principales.png")
hacer_figura([4,5,6],
             r"Términos de interacción separado: $a_{12}$ ($\sigma_{hit}D$), $a_{13}$ ($\sigma_{hit}\theta$), $a_{23}$ ($D\theta$)",
             "coef_sep_interacciones.png")