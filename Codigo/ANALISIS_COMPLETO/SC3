matriz_mapas(X4g1, r"Mapas $\gamma_1\,\text{(mm)}$ 4 hits eje X",     "X4_gamma1", desv_compartida=desv_g1, param=r"$\gamma_1$")
matriz_mapas(X4g2, r"Mapas $\gamma_2\,\text{(mm)}$ 4 hits eje X",     "X4_gamma2", desv_compartida=desv_g2, param=r"$\gamma_2$")
matriz_mapas(Z3g,  r"Mapas $\gamma_s\,\text{(mm)}$ 3 hits eje Z",       "Z3_gamma",  desv_compartida=desv_g3, param=r"$\gamma_s$")
matriz_mapas(Z4g1, r"Mapas $\gamma_1\,\text{(mm)}$ 4 hits eje Z",     "Z4_gamma1", desv_compartida=desv_g1, param=r"$\gamma_1$")
