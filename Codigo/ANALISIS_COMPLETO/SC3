evolucion_vs_sigma(Z3g,  Z3e,  r"Evolución $\gamma_s\,\text{(mm)}$ 3 hits eje Z",   "Z3_gamma",  r"$\gamma_s$ (mm)")
evolucion_vs_sigma(Z4g1, Z4e1, r"Evolución $\gamma_1\,\text{(mm)}$ 4 hits eje Z", "Z4_gamma1", r"$\gamma_1$ (mm)")
evolucion_vs_sigma(Z4g2, Z4e2, r"Evolución $\gamma_2\,\text{(mm)}$ 4 hits eje Z", "Z4_gamma2", r"$\gamma_2$ (mm)")

