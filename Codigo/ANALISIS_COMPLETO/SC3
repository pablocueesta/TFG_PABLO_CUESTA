evolucion_vs_sigma(X3g,  X3e,  r"Evolución $\gamma_s\,\text{(mm)}$ 3 hits eje X",   "X3_gamma",  r"$\gamma_s$ (mm)")
evolucion_vs_sigma(X4g1, X4e1, r"Evolución $\gamma_1\,\text{(mm)}$ 4 hits eje X", "X4_gamma1", r"$\gamma_1$ (mm)")
