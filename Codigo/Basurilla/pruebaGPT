import pandas as pd
import numpy as np

archivo = r"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\muon_hits_complete.csv"
salida = r"C:\Users\pablo\OneDrive\Escritorio\FISICA\Cuarto Fisica\TFG\residuos_muones.txt"

df = pd.read_csv(archivo)

coords = df[['X','Y','Z']].to_numpy().reshape(-1,4,3)

mask = np.all(coords != -99999, axis=2)
hits = mask.sum(axis=1)

combos = np.array([[0,1,2],[0,1,3],[0,2,3],[1,2,3]])

coords4 = coords[hits==4][:,combos]
x,y,z = coords4[:,:,:,0], coords4[:,:,:,1], coords4[:,:,:,2]

m_x = (x[:,:,0]-x[:,:,2])/(z[:,:,0]-z[:,:,2])
x_teo = m_x*z[:,:,1] + (x[:,:,0]-m_x*z[:,:,0])
resX4 = np.min(np.abs(x[:,:,1]-x_teo),axis=1)

m_y = (y[:,:,0]-y[:,:,2])/(z[:,:,0]-z[:,:,2])
y_teo = m_y*z[:,:,1] + (y[:,:,0]-m_y*z[:,:,0])
resY4 = np.min(np.abs(y[:,:,1]-y_teo),axis=1)

with open(salida,"w") as f:
    for i,(rx,ry) in enumerate(zip(resX4,resY4)):
        f.write(f"Evento {i}: ResX_min={rx:.3f} ResY_min={ry:.3f}\n")