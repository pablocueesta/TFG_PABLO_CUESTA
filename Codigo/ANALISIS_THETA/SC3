def limpiar(x, y, e=None):
    if e is not None:
        mask = np.isfinite(x)&np.isfinite(y)&np.isfinite(e)&(e>0)&(y>0)&(y<5)
        return x[mask], y[mask], e[mask]
    mask = np.isfinite(x)&np.isfinite(y)&(y>0)
    return x[mask], y[mask]

f_out = open(os.path.join(carpeta, "pendientes_angulos.txt"), "w", encoding="utf-8")

def plot_separado(ang, g3, e3, g1, e1, g2, e2, ge,
                  p95_3, p95_4, titulo, nombre):

    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(9,10), sharex=True)
    fig.suptitle(titulo)

    # --- panel 1: gammas vs ang ---
    xs, ys, ees = limpiar(ang, g3,  e3)
    x1, y1, ee1 = limpiar(ang, g1,  e1)
    x2, y2, ee2 = limpiar(ang, g2,  e2)
    #xge, yge    = limpiar(ang, ge)

    ax1.errorbar(xs, ys, yerr=ees, fmt='o', color='blue',   capsize=3, label='3 hits gamma simple')
    ax1.errorbar(x1, y1, yerr=ee1, fmt='s', color='green',  capsize=3, label='4 hits gamma1 (core)')
    ax1.errorbar(x2, y2, yerr=ee2, fmt='^', color='red',    capsize=3, label='4 hits gamma2 (cola)')
    #ax1.plot(xge, yge, 'D--', color='orange', label='4 hits gamma_eff')

    f_out.write(f"\n--- {titulo} ---\n")
    
    # 3 hits: fit solo hasta 50° porque el punto de 60° no aparece (fit colapsado)
    mask_50 = xs <= 50
    x50, y50, e50 = xs[mask_50], ys[mask_50], ees[mask_50]
    if len(x50) >= 3:
        p, cov = np.polyfit(x50, y50, 1, w=1/e50, cov=True)
        xf = np.linspace(min(x50), max(x50), 200)
        ax1.plot(xf, p[0]*xf+p[1], color='blue', linewidth=2,
            label=f'Fit 3hits (0-50°): a={p[0]:.4f}+-{np.sqrt(cov[0,0]):.4f}')
        f_out.write(f"3hits gamma: a={p[0]:.4f}+-{np.sqrt(cov[0,0]):.4f}"
            f", b={p[1]:.4f}+-{np.sqrt(cov[1,1]):.4f}\n")

    # 4 hits: fit con todos los puntos incluyendo 60°
    for (x, y, e, color, etiq) in [
        (x1, y1, ee1, 'green', '4hits gamma1'),
        (x2, y2, ee2, 'red',   '4hits gamma2'),
    ]:
        if len(x) >= 3:
            p, cov = np.polyfit(x, y, 1, w=1/e, cov=True)
            xf = np.linspace(min(x), max(x), 200)
            ax1.plot(xf, p[0]*xf+p[1], color=color, linewidth=2,
                label=f'Fit {etiq}: a={p[0]:.4f}+-{np.sqrt(cov[0,0]):.4f}')
            f_out.write(f"{etiq}: a={p[0]:.4f}+-{np.sqrt(cov[0,0]):.4f}"
                f", b={p[1]:.4f}+-{np.sqrt(cov[1,1]):.4f}\n")

    
    ax1.set_ylabel("gamma [mm]"); ax1.legend(fontsize=8); ax1.grid()

    # --- panel 2: semiancho corte p95 vs ang (3 hits y 4 hits) ---
    xc3, yc3 = limpiar(ang, p95_3)
    xc4, yc4 = limpiar(ang, p95_4)

    ax2.plot(xc3, yc3, 'o-', color='blue',  linewidth=2, label='Semianchura del percentil 95 — 3 hits')
    ax2.plot(xc4, yc4, 's-', color='green', linewidth=2, label='Semianchura del percentil 95 — 4 hits')

    for (xc, yc, color, etiq) in [(xc3, yc3, 'blue', 'p95_3hits'),
                                   (xc4, yc4, 'green','p95_4hits')]:
        if len(xc) >= 3:
            #p2 = np.polyfit(xc, yc, 1)
            xf = np.linspace(min(xc), max(xc), 200)
            #ax2.plot(xf, p2[0]*xf+p2[1], '--', color=color, linewidth=1.5,
                     #label=f'Fit {etiq}: a={p2[0]:.4f}, b={p2[1]:.4f}')
            #f_out.write(f"{etiq}: a={p2[0]:.4f}, b={p2[1]:.4f}\n")

    
    ax2.set_xlabel("Ángulo [grados]"); ax2.set_ylabel("Semianchura del percentil 95 [mm]")
    ax2.set_title("Ventana de ajuste (semianchura del percentil 95) vs Ángulo")
    ax2.legend(fontsize=8); ax2.grid()

    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=200)
    plt.close()
    print(f"Guardado: {nombre}.png")

