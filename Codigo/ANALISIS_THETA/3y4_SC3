def limpiar(x, y, e=None):
    if e is not None:
        mask = np.isfinite(x)&np.isfinite(y)&np.isfinite(e)&(e>0)&(y>0)&(y<5)
        return x[mask], y[mask], e[mask]
    mask = np.isfinite(x)&np.isfinite(y)&(y>0)
    return x[mask], y[mask]

f_out = open(os.path.join(carpeta, "pendientes_angulos.txt"), "w", encoding="utf-8")

def plot_Ang_comb(Ang, gs, es, g1, e1, g2, e2, ge, p95_ancho, titulo, nombre):

    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(9,10), sharex=True)
    fig.suptitle(titulo)

    # --- panel superior: gammas ---
    #xs, ys, ees = limpiar(Ang, gs, es)
    x1, y1, ee1 = limpiar(Ang, g1, e1)
    x2, y2, ee2 = limpiar(Ang, g2, e2)
    #xge, yge    = limpiar(Ang, ge)

    #ax1.errorbar(xs, ys, yerr=ees, fmt='o', color='orange', capsize=3, label='gamma simple')
    ax1.errorbar(x1, y1, yerr=ee1, fmt='s', color='blue',   capsize=3, label='gamma1 core')
    ax1.errorbar(x2, y2, yerr=ee2, fmt='^', color='red',    capsize=3, label='gamma2 cola')
    #ax1.plot(xge, yge, 'D--', color='green', label='gamma_eff')

    f_out.write(f"\n--- {titulo} ---\n")
    for (x, y, e, color, etiq) in [(x1, y1, ee1, 'blue', 'gamma1'),
                                (x2, y2, ee2, 'red',  'gamma2')]:
        mask = x <= 50 if etiq == 'gamma2' else np.ones(len(x), dtype=bool)
        xm, ym, em = x[mask], y[mask], e[mask]
        if len(xm) >= 3:
            p, cov = np.polyfit(xm, ym, 1, w=1/em, cov=True)
            xf = np.linspace(min(xm), max(xm), 200)
            label_fit = f'Fit {etiq} (0-50°): a={p[0]:.4f}+-{np.sqrt(cov[0,0]):.4f}' \
                    if etiq == 'gamma2' else \
                    f'Fit {etiq}: a={p[0]:.4f}+-{np.sqrt(cov[0,0]):.4f}'
            ax1.plot(xf, p[0]*xf+p[1], color=color, linewidth=2, label=label_fit)
            f_out.write(f"{etiq}: a={p[0]:.4f}+-{np.sqrt(cov[0,0]):.4f}"
                        f", b={p[1]:.4f}+-{np.sqrt(cov[1,1]):.4f}\n")

    #ax1.axvline(7.0, color='gray', linestyle=':', linewidth=1, label='D=d=7cm')
    ax1.set_ylabel("gamma [mm]"); ax1.legend(fontsize=8); ax1.grid()

    # --- panel inferior: ancho del corte p95 vs D ---
    xc, yc = limpiar(Ang, p95_ancho)
    ax2.plot(xc, yc, 'D-',
         color='magenta',
         linewidth=2,
         label='Semianchura del percentil 95 [mm]')
    if len(xc) >= 3:
        #p2 = np.polyfit(xc, yc, 1)
        xf = np.linspace(min(xc), max(xc), 200)
        #ax2.plot(xf, p2[0]*xf+p2[1], '--', color='darkviolet', linewidth=2,
                 #label=f'Fit lineal: a={p2[0]:.4f}, b={p2[1]:.4f}')
        #f_out.write(f"p95_semiancho: a={p2[0]:.4f}, b={p2[1]:.4f}\n")

    #ax2.axvline(7.0, color='gray', linestyle=':', linewidth=1)
    ax2.set_xlabel("Ángulo [grados]"); ax2.set_ylabel("Semianchura del percentil 95 [mm]")
    ax2.set_title("Ventana de ajuste (semianchura del percentil 95) vs Ángulo")
    ax2.legend(fontsize=8); ax2.grid()

    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, f"{nombre}.png"), dpi=200)
    plt.close()
    print(f"Guardado: {nombre}.png")

