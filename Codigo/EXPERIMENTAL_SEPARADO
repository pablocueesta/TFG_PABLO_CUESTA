        resultados = {}
        if simple3_ok:
            sh3, esh3 = despejar_sigma(gamma3s, err_g3s, D_FIJO, theta, coef_g3)
            resultados['3hits gamma_s'] = (gamma3s, err_g3s, sh3, esh3)
            print(f"  -> sigma_hit (3hits): {sh3:.4f}+-{esh3:.4f} mm")
        if double4_ok:
            sh1_4, esh1_4 = despejar_sigma(g1_4, eg1_4, D_FIJO, theta, coef_g1)
            sh2_4, esh2_4 = despejar_sigma(g2_4, eg2_4, D_FIJO, theta, coef_g2)
            resultados['4hits gamma1'] = (g1_4, eg1_4, sh1_4, esh1_4)
            resultados['4hits gamma2'] = (g2_4, eg2_4, sh2_4, esh2_4)
            print(f"  -> sigma_hit (4hits g1): {sh1_4:.4f}+-{esh1_4:.4f} mm")
            print(f"  -> sigma_hit (4hits g2): {sh2_4:.4f}+-{esh2_4:.4f} mm  <-- RESULTADO ESPERADO")

        # ── PLOTS: 3 paneles ─────────────────────────────────────────────────
