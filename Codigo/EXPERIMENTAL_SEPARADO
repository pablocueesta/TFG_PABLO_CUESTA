def gamma_modelo(sigma, D, theta, c):
    return (c['a0'] + c['a1']*sigma + c['a2']*D + c['a3']*theta
            + c['a12']*sigma*D + c['a13']*sigma*theta + c['a23']*D*theta)

def despejar_sigma(gamma_exp, err_gamma_exp, D, theta, c):
    denom = c['a1'] + c['a12']*D + c['a13']*theta
    if denom == 0 or not np.isfinite(gamma_exp): return np.nan, np.nan
    num = gamma_exp - c['a0'] - c['a2']*D - c['a3']*theta - c['a23']*D*theta
    return num/denom, err_gamma_exp/abs(denom)

def lorentz(x, A, mu, gamma):
    return A / (1 + ((x-mu)/gamma)**2)

def double_lorentz(x, A1, gamma1, A2, gamma2, mu):
    return (A1/(1+((x-mu)/gamma1)**2) + A2/(1+((x-mu)/gamma2)**2))

def chi2_reducido(y_data, y_fit, n_params):
    mask = y_data > 0
    r    = y_data[mask] - y_fit[mask]
    chi2 = np.sum(r**2/y_data[mask])
    ndf  = np.sum(mask) - n_params
    return np.nan if ndf <= 0 else chi2/ndf

def aplicar_percentil(data, p=95):
    low  = np.percentile(data, (100-p)/2)
    high = np.percentile(data, 100-(100-p)/2)
    return data[(data>low)&(data<high)], low, high

