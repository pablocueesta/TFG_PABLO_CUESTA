        f_res.write("\nEstimacion sigma_hit:\n")
        for metodo, (g_exp,eg_exp,sh,esh) in resultados.items():
            esp = "  <-- RESULTADO ESPERADO (colas)" if "gamma2" in metodo else ""
            if np.isfinite(sh):
                f_res.write(f"  [{metodo}]: gamma={g_exp:.4f}+-{eg_exp:.4f}"
