        mask3 = (nhits_all==3) & np.isfinite(residuals_all) & (np.abs(residuals_all)<=LIMITE)
        mask4 = (nhits_all==4) & np.isfinite(residuals_all) & (np.abs(residuals_all)<=LIMITE)
        data3_full = residuals_all[mask3]
        data4_full = residuals_all[mask4]
