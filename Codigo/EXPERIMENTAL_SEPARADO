        g1_curva = gamma_modelo(sf, D_FIJO, theta, coef_g1)
        ax_mod.plot(sf, g1_curva, color='blue', linewidth=2,
                    label=rf"Modelo $\gamma_1$")

        g2_curva = gamma_modelo(sf, D_FIJO, theta, coef_g2)
        ax_mod.plot(sf, g2_curva, color='red', linewidth=2,
                    label=rf"Modelo $\gamma_2$")

        if simple3_ok and '3hits gamma_s' in resultados:
            sh3, esh3 = resultados['3hits gamma_s'][2:]
            if np.isfinite(sh3) and sh3>0:
                ax_mod.axhline(gamma3s, color='steelblue', linestyle='--', linewidth=1.2,
                               label=rf"$\gamma_s$={gamma3s:.4f}±{err_g3s:.4f} mm")
                ax_mod.axvline(sh3, color='steelblue', linestyle=':', linewidth=1.2)
                ax_mod.errorbar(sh3, gamma3s, xerr=esh3, fmt='o', color='steelblue',
                                markersize=6, capsize=6, linewidth=1.5, zorder=5,
                                label=rf"$\sigma_{{hit}}\,$($\gamma_s$)={sh3:.4f}±{esh3:.4f} mm")

        if double4_ok and '4hits gamma1' in resultados:
            sh1v, esh1v = resultados['4hits gamma1'][2:]
            if np.isfinite(sh1v) and sh1v>0:
                ax_mod.axhline(g1_4, color='blue', linestyle='--', linewidth=1.2,
