# --------------------------------------------------

# 3 hits X (eje_sim=Z)
COEF_G3_SIM_Z = dict(a0=0.011047, a1=1.2404, a2=0.0, a3=0.0, a12=0.0, a13=-0.002491, a23=0.0)

# 3 hits Y (eje_sim=X)
COEF_G3_SIM_X = dict(a0=0.0, a1=1.2459, a2=0.00037, a3=0.000227, a12=0.0, a13=0.0, a23=0.0)

# 4 hits gamma1 X (eje_sim=Z)
COEF_G1_SIM_Z = dict(a0=0.0, a1=0.1083, a2=0.0, a3=0.0, a12=0.0, a13=0.0, a23=0.0)

# 4 hits gamma2 X (eje_sim=Z)
COEF_G2_SIM_Z = dict(a0=0.003073, a1=0.2195, a2=0.0, a3=0.0, a12=0.01531, a13=0.0, a23=0.0)

