        fig.suptitle(f"Detector {titulos_det[det]} — {titulos_coord[coord_exp]}"
                     rf" (eje ${eje_sim}$ simulado) $\theta={theta}°$, $D={D_FIJO}\,\text{{cm}}$", fontsize=16)

        # panel izquierdo: histograma 3 hits
        ax3 = axes[0]
        ax3.bar(centers3[hist3>0], hist3[hist3>0], width=width3,
                alpha=0.6, color='steelblue', label=f"3 hits (p95) N={len(data3):,}")
        xf3 = np.linspace(-margen3, margen3, 600)
        if simple3_ok:
            ax3.plot(xf3, lorentz(xf3,A3s,mu3s,gamma3s), color='orange', linewidth=2,
                     label=rf"Fit $\gamma_s$={gamma3s:.3f}±{err_g3s:.3f} mm")
        ax3.axvline(p95_lo3, color='magenta', linewidth=1.5,
                    label=f"p95:[{p95_lo3:.2f},{p95_hi3:.2f}]")
        ax3.axvline(p95_hi3, color='magenta', linewidth=1.5)
        ax3.set_yscale('log')
        ax3.set_xlabel("Residual (mm)", fontsize=12); ax3.set_ylabel("Cuentas (log)", fontsize=12)
        ax3.set_title("Distribución 3 hits — Lorentz simple\n(percentil 95%)", fontsize=14)
        ax3.legend(fontsize=10); ax3.grid(which='both', linestyle='--', alpha=0.5)

        # panel central: histograma 4 hits
        ax4 = axes[1]
        ax4.bar(centers4[hist4>0], hist4[hist4>0], width=width4,
                alpha=0.6, color='salmon', label=f"4 hits (p95) N={len(data4):,}")
        xf4 = np.linspace(-margen4, margen4, 600)
        if double4_ok:
            ax4.plot(xf4, double_lorentz(xf4,A1_4,g1_4,A2_4,g2_4,mu4),
                     color='red', linewidth=2, label=rf"Doble Lorentz: $\gamma_1$, $\gamma_2$")
            ax4.plot(xf4, lorentz(xf4,A1_4,mu4,g1_4),
                     '--', color='blue', linewidth=1.5,
                     label=rf"Core: $\gamma_1$={g1_4:.3f}±{eg1_4:.3f} mm")
            ax4.plot(xf4, lorentz(xf4,A2_4,mu4,g2_4),
