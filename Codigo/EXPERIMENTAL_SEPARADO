        # percentil 95 por separado
        data3, p95_lo3, p95_hi3 = aplicar_percentil(data3_full)
        data4, p95_lo4, p95_hi4 = aplicar_percentil(data4_full)
        margen3 = max(abs(p95_lo3), abs(p95_hi3))
        margen4 = max(abs(p95_lo4), abs(p95_hi4))

        # ── FIT 3 HITS: Lorentz simple ───────────────────────────────────────
        gamma0_3 = data3.std()*0.5
        hist3, bins3 = np.histogram(data3, bins=N_BINS, range=(-margen3, margen3))
        centers3 = (bins3[:-1]+bins3[1:])/2; width3 = bins3[1]-bins3[0]

        simple3_ok = False
        try:
            ps3, covs3 = curve_fit(lorentz, centers3, hist3,
                                   p0=[max(hist3), np.median(data3), gamma0_3],
                                   bounds=([0,-margen3,0.001],[np.inf,margen3,margen3*2]),
                                   maxfev=20000)
            A3s, mu3s, gamma3s = [float(p) for p in ps3]
            err_g3s = float(np.sqrt(np.diag(covs3))[2])
            chi2_3s = chi2_reducido(hist3, lorentz(centers3,A3s,mu3s,gamma3s), 3)
            simple3_ok = True
            print(f"  3hits Lorentz: gamma={gamma3s:.4f}+-{err_g3s:.4f}  chi2={chi2_3s:.2f}")
        except RuntimeError:
            print("  3hits fit fallido"); gamma3s=err_g3s=chi2_3s=np.nan

        # ── FIT 4 HITS: Doble Lorentz ────────────────────────────────────────
        gamma0_4 = data4.std()*0.5
        hist4, bins4 = np.histogram(data4, bins=N_BINS, range=(-margen4, margen4))
        centers4 = (bins4[:-1]+bins4[1:])/2; width4 = bins4[1]-bins4[0]

        double4_ok = False
        try:
            pd0 = [max(hist4),gamma0_4*0.3,max(hist4)/5,gamma0_4*2.0,float(np.median(data4))]
            pdl4, covdl4 = curve_fit(double_lorentz, centers4, hist4,
                                     p0=pd0,
                                     bounds=([0,0.001,0,0.001,-margen4],
                                             [np.inf,margen4*2,np.inf,margen4*2,margen4]),
                                     maxfev=20000)
            A1_4,g1_4,A2_4,g2_4,mu4 = [float(p) for p in pdl4]
            errs4 = np.sqrt(np.diag(covdl4))
            eg1_4, eg2_4 = float(errs4[1]), float(errs4[3])
            if g1_4>g2_4:
                A1_4,A2_4=A2_4,A1_4; g1_4,g2_4=g2_4,g1_4; eg1_4,eg2_4=eg2_4,eg1_4
            if 0<g1_4<margen4*2 and 0<g2_4<margen4*2:
                double4_ok = True
                chi2_4dl = chi2_reducido(hist4,double_lorentz(centers4,A1_4,g1_4,A2_4,g2_4,mu4),5)
                print(f"  4hits Doble: g1={g1_4:.4f} g2={g2_4:.4f} chi2={chi2_4dl:.2f}")
        except RuntimeError:
            print("  4hits doble fit fallido")

