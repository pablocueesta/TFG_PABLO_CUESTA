        ax4.axvline(p95_hi4, color='magenta', linewidth=1.5)
        ax4.set_yscale('log')
        ax4.set_xlabel("Residual (mm)", fontsize=12)
        ax4.set_ylabel("Cuentas (log)", fontsize=12)
        ax4.set_title("Distribución 4 hits — Doble Lorentz\n(percentil 95%)", fontsize=14)
        ax4.legend(fontsize=9); ax4.grid(which='both', linestyle='--', alpha=0.5)

        # panel derecho: curvas del modelo + interpolacion (igual que EXPERIMENTAL)
        ax_mod = axes[2]
