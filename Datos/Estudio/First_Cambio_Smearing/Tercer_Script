# =========================
# PLOTS SEPARADOS SIGMA1 Y SIGMA2
# =========================

def plot_separado(s_hit, sg, err, titulo, nombre, color):
    """Plotea una sola sigma en función del smearing."""

    x, y, e = limpiar_datos(s_hit, sg, err)

    if len(x) < 3:
        print(f"Pocos puntos válidos para {titulo}")
        return

    plt.figure(figsize=(8,6))

    plt.errorbar(
        x, y, yerr=e,
        fmt='o',
        color=color,
        capsize=3,
        label=titulo
    )

    # fit lineal sobre todos los puntos válidos
    params, cov = np.polyfit(x, y, 1, w=1/e, cov=True)
    a, b = params
    err_a = np.sqrt(cov[0,0])
    err_b = np.sqrt(cov[1,1])

    xfit = np.linspace(min(x), max(x), 200)

    plt.plot(
        xfit,
        a*xfit + b,
        color=color,
        linewidth=2,
        label=f'Fit: a={a:.3f}±{err_a:.3f}, b={b:.4f}±{err_b:.4f}'
    )

    plt.xlabel("Smearing [mm]")
    plt.ylabel("Resolución experimental [mm]")
    plt.title(titulo)
    plt.grid()
    plt.legend()

    ruta = os.path.join(out_dir, f"{nombre}.png")
    plt.savefig(ruta, dpi=300)
    plt.close()

    print(f"{titulo}: a={a:.4f}±{err_a:.4f}, b={b:.4f}±{err_b:.4f}")


