# -------------------------
# ORDENAR SIGMAS (core < cola)
# -------------------------
def ordenar_sigmas(sg1, sg2):
    sg1_new = np.minimum(sg1, sg2)
    sg2_new = np.maximum(sg1, sg2)
    return sg1_new, sg2_new

X3_sg1, X3_sg2 = ordenar_sigmas(X3_sg1, X3_sg2)
