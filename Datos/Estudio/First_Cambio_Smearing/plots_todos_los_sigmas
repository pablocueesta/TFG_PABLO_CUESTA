def plot_y_fit(s_hit, sg1, err1, sg2, err2, titulo, nombre):

    plt.figure()

    color_sg1 = 'blue'   # Color para sigma1
    color_sg2 = 'red'    # Color para sigma2

    s_hit1, sg1, err1 = limpiar_datos(s_hit, sg1, err1)
    s_hit2, sg2, err2 = limpiar_datos(s_hit, sg2, err2)

    # datos
    plt.errorbar(s_hit1, sg1, yerr=err1, fmt='o', capsize=3)
    plt.errorbar(s_hit2, sg2, yerr=err2, fmt='s', capsize=3)

    # FIT σ1
    a1, b1, ea1, eb1 = fit_lineal(s_hit, sg1, err1)
    x_fit = np.linspace(min(s_hit), max(s_hit), 200)

    plt.plot(x_fit, a1*x_fit + b1,
             label=f"σ1: a={a1:.3f}±{ea1:.3f}", color=color_sg1)

    # FIT σ2
    a2, b2, ea2, eb2 = fit_lineal(s_hit, sg2, err2)

    plt.plot(x_fit, a2*x_fit + b2,
             label=f"σ2: a={a2:.3f}±{ea2:.3f}", color=color_sg2)

    # estética
    plt.xlabel("Smearing [mm]")
    plt.ylabel("Resolución experimental [mm]")
    plt.title(titulo)
    plt.legend()
    plt.grid()

    # guardar plot
    ruta = os.path.join(out_dir, f"{nombre}.png")
    plt.savefig(ruta, dpi=300)
    plt.close()

    # guardar resultados en txt
    f_out.write(f"\n--- {titulo} ---\n")
    f_out.write(f"sigma1: a = {a1:.4f} +- {ea1:.4f}, b = {b1:.4f} +- {eb1:.4f}\n")
    f_out.write(f"sigma2: a = {a2:.4f} +- {ea2:.4f}, b = {b2:.4f} +- {eb2:.4f}\n")

    # print también
    print(f"\n--- {titulo} ---")
    print(f"sigma1: a = {a1:.4f} +- {ea1:.4f}")
    print(f"sigma2: a = {a2:.4f} +- {ea2:.4f}")

